new file mode 100644
index 000000000..e7f9e7b87
--- /dev/null
+++ b/extensions/cli/src/ui/components/FullscreenTranscript.tsx
@@ -0,0 +1,271 @@
+import type { ChatHistoryItem } from "core/index.js";
+import { Box, DOMElement, measureElement, useInput, useStdin } from "ink";
+import React, {
+  useCallback,
+  useEffect,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+} from "react";
+
+import { useTerminalSize } from "../hooks/useTerminalSize.js";
+
+const OVERSCAN_ROWS = 8;
+const WHEEL_STEP = 3;
+
+interface FullscreenTranscriptProps {
+  items: ChatHistoryItem[];
+  renderMessage: (
+    item: ChatHistoryItem,
+    index: number,
+    allMessages?: ChatHistoryItem[],
+  ) => React.ReactElement;
+  intro?: React.ReactNode;
+  footer?: React.ReactNode;
+}
+
+function itemId(item: ChatHistoryItem, index: number): string {
+  const id = (item.message as { id?: string }).id;
+  return id ?? `${item.message.role}-${index}`;
+}
+
+function estimateHeight(item: ChatHistoryItem, columns: number): number {
+  const content =
+    typeof item.message.content === "string"
+      ? item.message.content
+      : JSON.stringify(item.message.content ?? "");
+  const lines = content.split("\n").reduce((total, line) => {
+    return total + Math.max(1, Math.ceil(Math.max(1, line.length) / columns));
+  }, 0);
+  const toolLines = item.toolCallStates?.length ? 2 : 0;
+  return Math.max(1, lines + toolLines);
+}
+
+function lowerBound(offsets: number[], value: number): number {
+  let low = 0;
+  let high = offsets.length;
+  while (low < high) {
+    const mid = Math.floor((low + high) / 2);
+    if (offsets[mid] < value) low = mid + 1;
+    else high = mid;
+  }
+  return low;
+}
+
+/**
+ * Full-screen, internally scrolling transcript.
+ *
+ * The terminal alternate buffer deliberately has no shell scrollback. This
+ * component owns the scroll position and only mounts the rows around it, so
+ * PageUp/PageDown and the mouse wheel cannot jump back into the CMD prompt
+ * history. Heights are measured in terminal rows and cached by message id.
+ */
+export function FullscreenTranscript(props: FullscreenTranscriptProps) {
+  const { columns } = useTerminalSize();
+  const { stdin } = useStdin();
+  const viewportRef = useRef<DOMElement>(null);
+  const rowRefs = useRef(new Map<string, DOMElement>());
+  const heights = useRef(new Map<string, number>());
+  const [measureVersion, setMeasureVersion] = useState(0);
+  const [viewportHeight, setViewportHeight] = useState(10);
+  const [scrollTop, setScrollTop] = useState(0);
+  const [followBottom, setFollowBottom] = useState(true);
+  const previousUserCount = useRef(0);
+
+  const ids = useMemo(
+    () => props.items.map((item, index) => itemId(item, index)),
+    [props.items],
+  );
+
+  const userCount = useMemo(
+    () => props.items.filter((item) => item.message.role === "user").length,
+    [props.items],
+  );
+
+  const offsets = useMemo(() => {
+    const result: number[] = [];
+    let offset = 0;
+    props.items.forEach((item, index) => {
+      result.push(offset);
+      offset +=
+        heights.current.get(ids[index]) ??
+        estimateHeight(item, Math.max(20, columns));
+    });
+    return result;
+  }, [props.items, ids, columns, measureVersion]);
+
+  const totalHeight = useMemo(() => {
+    if (props.items.length === 0) return 0;
+    const last = props.items.length - 1;
+    return (
+      offsets[last] +
+      (heights.current.get(ids[last]) ??
+        estimateHeight(props.items[last], Math.max(20, columns)))
+    );
+  }, [props.items, ids, offsets, columns, measureVersion]);
+
+  const maxScroll = Math.max(0, totalHeight - viewportHeight);
+  // When following, derive the position from the measured total instead of
+  // storing it. That avoids a layout/measurement feedback loop while rows
+  // above the viewport are being measured.
+  const effectiveScrollTop = followBottom
+    ? maxScroll
+    : Math.max(0, Math.min(maxScroll, scrollTop));
+
+  const scrollBy = useCallback(
+    (amount: number) => {
+      const next = Math.max(
+        0,
+        Math.min(maxScroll, effectiveScrollTop + amount),
+      );
+      setScrollTop(next);
+      // Following resumes only when the viewport is back at the very bottom.
+      setFollowBottom(next >= maxScroll);
+    },
+    [maxScroll, effectiveScrollTop],
+  );
+
+  useLayoutEffect(() => {
+    if (userCount > previousUserCount.current) {
+      setFollowBottom(true);
+    }
+    previousUserCount.current = userCount;
+  }, [userCount]);
+
+  // Measure the flex-grown viewport after Ink lays it out.
+  useLayoutEffect(() => {
+    const node = viewportRef.current;
+    if (!node) return;
+    const height = measureElement(node).height;
+    if (height > 0 && height !== viewportHeight) {
+      setViewportHeight(height);
+    }
+  });
+
+  // Measure only the rows currently mounted; estimates cover the rest.
+  useLayoutEffect(() => {
+    let changed = false;
+    for (const [id, node] of rowRefs.current) {
+      const height = Math.max(1, measureElement(node).height);
+      if (heights.current.get(id) !== height) {
+        heights.current.set(id, height);
+        changed = true;
+      }
+    }
+    if (changed) {
+      setMeasureVersion((version) => version + 1);
+    }
+  });
+
+  const getRowRef = useCallback(
+    (id: string) => (node: DOMElement | null) => {
+      if (node) {
+        rowRefs.current.set(id, node);
+      } else {
+        rowRefs.current.delete(id);
+      }
+    },
+    [],
+  );
+
+  useInput((input, key) => {
+    if (key.shift && key.upArrow) {
+      scrollBy(-1);
+      return;
+    }
+    if (key.shift && key.downArrow) {
+      scrollBy(1);
+    }
+  });
+
+  // Ink does not expose Home/End or wheel events in useInput. Parse the raw
+  // SGR/X10 sequences here; keyboard PageUp/PageDown remains the fallback.
+  useEffect(() => {
+    const onData = (data: Buffer) => {
+      const sequence = data.toString("utf8");
+      const sgrWheel = /\x1b\[<(\d+);\d+;\d+[Mm]/g;
+      let match: RegExpExecArray | null;
+      while ((match = sgrWheel.exec(sequence)) !== null) {
+        const button = Number(match[1]);
+        if (button === 64) scrollBy(-WHEEL_STEP);
+        if (button === 65) scrollBy(WHEEL_STEP);
+      }
+
+      if (sequence.includes("\x1b[5~")) {
+        scrollBy(-viewportHeight);
+      }
+      if (sequence.includes("\x1b[6~")) {
+        scrollBy(viewportHeight);
+      }
+      if (sequence.includes("\x1b[H") || sequence.includes("\x1b[1~")) {
+        setFollowBottom(false);
+        setScrollTop(0);
+      }
+      if (sequence.includes("\x1b[F") || sequence.includes("\x1b[4~")) {
+        setFollowBottom(true);
+      }
+
+      // X10 mouse wheel: ESC [ M followed by button, x, y bytes.
+      for (let i = 0; i + 5 < sequence.length; i++) {
+        if (
+          sequence[i] === "\x1b" &&
+          sequence[i + 1] === "[" &&
+          sequence[i + 2] === "M"
+        ) {
+          const button = sequence.charCodeAt(i + 3) - 32;
+          if (button === 64) scrollBy(-WHEEL_STEP);
+          if (button === 65) scrollBy(WHEEL_STEP);
+        }
+      }
+    };
+
+    stdin.on("data", onData);
+    return () => {
+      stdin.off("data", onData);
+    };
+  }, [stdin, scrollBy, maxScroll, setScrollTop, viewportHeight]);
+
+  let startIndex = Math.max(0, lowerBound(offsets, effectiveScrollTop));
+  if (startIndex > 0 && (offsets[startIndex] ?? 0) > effectiveScrollTop) {
+    startIndex--;
+  }
+  if (props.items.length > 0) {
+    startIndex = Math.min(startIndex, props.items.length - 1);
+  }
+  const endIndex = Math.min(
+    props.items.length,
+    lowerBound(offsets, effectiveScrollTop + viewportHeight + OVERSCAN_ROWS) +
+      1,
+  );
+  const firstOffset = offsets[startIndex] ?? 0;
+  const visibleTop =
+    startIndex < endIndex ? firstOffset - effectiveScrollTop : 0;
+
+  return (
+    <Box
+      ref={viewportRef}
+      flexGrow={1}
+      minHeight={0}
+      flexDirection="column"
+      overflow="hidden"
+    >
+      <Box
+        flexDirection="column"
+        flexShrink={0}
+        marginTop={visibleTop < 0 ? visibleTop : 0}
+      >
+        {props.items.length === 0 && props.intro}
+        {props.items.slice(startIndex, endIndex).map((item, visibleIndex) => {
+          const index = startIndex + visibleIndex;
+          return (
+            <Box key={ids[index]} ref={getRowRef(ids[index])} flexShrink={0}>
+              {props.renderMessage(item, index, props.items)}
+            </Box>
+          );
+        })}
+        {props.footer}
+      </Box>
+    </Box>
+  );
+}
