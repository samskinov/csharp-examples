+  it("honours CONTINUE_CLI_NO_FULLSCREEN", () => {
+    const previous = process.env.CONTINUE_CLI_NO_FULLSCREEN;
+    process.env.CONTINUE_CLI_NO_FULLSCREEN = "1";
+    try {
+      expect(shouldUseFullscreen({ stdout: { isTTY: true } })).toBe(false);
+    } finally {
+      if (previous === undefined) {
