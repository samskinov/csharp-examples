+import { describe, expect, it } from "vitest";
+
+import { createFullscreenTerminal, shouldUseFullscreen } from "./fullscreen.js";
+
+function fakeStdout() {
+  const writes: string[] = [];
+  return {
+    writes,
+    stream: {
+      write: (value: string) => {
+        writes.push(value);
+        return true;
+      },
+    } as any,
+  };
+}
+
+describe("fullscreen terminal", () => {
+  it("enters and restores the alternate screen", () => {
+    const { writes, stream } = fakeStdout();
+    const terminal = createFullscreenTerminal(stream);
+
+    terminal.enter();
+    terminal.exit();
+    terminal.exit();
+
+    expect(writes[0]).toContain("\x1b[?1049h");
