+/**
+ * Ink's text input receives raw mouse sequences when wheel reporting is
+ * enabled in the full-screen mode. Ignore them so scrolling never inserts
+ * escape fragments into the prompt.
+ */
+export function isMouseSequence(input: string): boolean {
+  return (
+    input.includes("\x1b[<") ||
+    input.includes("[<") ||
+    input.startsWith("\x1b[M") ||
+    /^\x1b\[M/.test(input)
+  );
+}
