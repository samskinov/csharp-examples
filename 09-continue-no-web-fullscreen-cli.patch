+import type { ChatHistoryItem } from "core/index.js";
+import { Box, Text } from "ink";
+import { render } from "ink-testing-library";
+import React from "react";
+
+import { FullscreenTranscript } from "./FullscreenTranscript.js";
+
+function items(count: number): ChatHistoryItem[] {
+  return Array.from({ length: count }, (_, index) => ({
+    message: {
+      id: `message-${index}`,
+      role: "assistant",
+      content: `message ${index}`,
+    },
+    contextItems: [],
+  })) as ChatHistoryItem[];
+}
+
+describe("FullscreenTranscript", () => {
+  it("starts at the live tail and mounts a bounded window", () => {
+    const history = items(120);
+    const { lastFrame } = render(
+      <FullscreenTranscript
+        items={history}
+        renderMessage={(item) => <Text>{String(item.message.content)}</Text>}
+      />,
+    );
+
+    const frame = lastFrame() ?? "";
+    expect(frame).toContain("message 119");
+    expect(frame).not.toContain("message 0\n");
+  });
+
+  it("scrolls the viewport with PageUp without touching terminal scrollback", async () => {
+    const history = items(200);
+    const { lastFrame, stdin } = render(
+      <Box height={24} width={100} flexDirection="column">
+        <FullscreenTranscript
+          items={history}
+          renderMessage={(item) => <Text>{String(item.message.content)}</Text>}
+        />
+      </Box>,
+    );
+
+    // Let Ink finish the first layout so the viewport height is measured.
+    await new Promise((resolve) => setTimeout(resolve, 40));
+    stdin.write("\x1b[5~");
+    await new Promise((resolve) => setTimeout(resolve, 40));
+    stdin.write("\x1b[5~");
+    await new Promise((resolve) => setTimeout(resolve, 40));
+
+    const frame = lastFrame() ?? "";
+    expect(frame).not.toContain("message 199");
+    expect(frame).toContain("message ");
+  });
+});
