+  // network clients are blocked here too, so the model cannot bypass the
+  // removed web tools through a terminal command. Internal application
+  // networking (LLM API calls, package managers, git) is not affected.
+  if (isBlockedNetworkInvocation(baseCommand, args)) {
+    return true;
+  }
