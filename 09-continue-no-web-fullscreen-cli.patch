 /**
  * Checks if a command is critical and should always be disabled
  */
+const BLOCKED_NETWORK_COMMANDS = new Set([
+  "curl",
+  "wget",
+  "fetch",
+  "nc",
+  "netcat",
+  "ncat",
+  "telnet",
+  "ssh",
+  "scp",
+  "rsync",
+  "ftp",
+  "sftp",
+  "tftp",
+  "socat",
+  "invoke-webrequest",
+  "iwr",
+  "invoke-restmethod",
+  "irm",
+  "start-bitstransfer",
+  "test-netconnection",
+]);
+
+const PASSTHROUGH_WRAPPERS = new Set([
+  "sudo",
+  "doas",
+  "env",
+  "command",
+  "exec",
+  "nohup",
+  "time",
+  "xargs",
+]);
+
+const SHELL_WRAPPERS = new Set(["sh", "bash", "zsh", "powershell", "pwsh", "cmd"]);
+
+function normalizeCommandName(baseCommand: string): string {
+  return baseCommand
+    .toLowerCase()
+    .replace(/\\/g, "/")
+    .split("/")
+    .pop()!
+    .replace(/\.(exe|cmd|bat|ps1)$/i, "");
+}
+
+function isBlockedNetworkCommand(baseCommand: string): boolean {
+  return BLOCKED_NETWORK_COMMANDS.has(normalizeCommandName(baseCommand));
+}
+
+function containsBlockedNetworkCommand(args: string[]): boolean {
+  return args.some((arg) => {
+    const words = arg.split(/[\s;|&()"'`]+/);
+    return words.some((word) => word !== "" && isBlockedNetworkCommand(word));
+  });
+}
+
+function isBlockedNetworkInvocation(baseCommand: string, args: string[]): boolean {
+  if (isBlockedNetworkCommand(baseCommand)) {
+    return true;
+  }
+
+  const normalized = normalizeCommandName(baseCommand);
+
+  if (PASSTHROUGH_WRAPPERS.has(normalized)) {
+    return containsBlockedNetworkCommand(args);
+  }
+
+  if (SHELL_WRAPPERS.has(normalized)) {
+    const hasCommandFlag = args.some((arg) =>
+      /^(?:-[a-z]*c|\/c|-command)$/i.test(arg),
+    );
+    return hasCommandFlag && containsBlockedNetworkCommand(args);
+  }
+
+  return false;
+}
+
 function isCriticalCommand(baseCommand: string, args: string[]): boolean {
