+import { describe, expect, it } from "vitest";
+
+import {
+  mergeToolName,
+  normalizeToolArguments,
+  resolveToolName,
+  sanitizeToolName,
+  stripTrailingXmlTags,
+  tryParseToolArguments,
+} from "./toolCallSanitization";
+
+describe("sanitizeToolName", () => {
+  it("removes XML fragments around a valid tool name", () => {
+    expect(sanitizeToolName("Read</arg_value>")).toBe("Read");
+    expect(sanitizeToolName("<tool_call>Read")).toBe("Read");
+    expect(sanitizeToolName("<function=Read>")).toBe("Read");
+    expect(sanitizeToolName("Read<arg_key>filepath")).toBe("Read");
+  });
+
+  it("returns an empty string for pure closing tags", () => {
+    expect(sanitizeToolName("</arg_value>")).toBe("");
+    expect(sanitizeToolName("</tool_call>")).toBe("");
+  });
+});
+
+describe("mergeToolName", () => {
+  it("keeps the real name when a provider streams a closing tag", () => {
+    expect(mergeToolName("Read", "</arg_value>")).toBe("Read");
+  });
+
+  it("still supports progressive and fragmented names", () => {
+    expect(mergeToolName("rea", "dFi")).toBe("readFi");
+    expect(mergeToolName("readFi", "readFil")).toBe("readFil");
+    expect(mergeToolName("readFile", "readFile")).toBe("readFile");
+  });
+});
+
+describe("resolveToolName", () => {
+  const tools = ["Read", "Bash", "EditExistingFile"];
+
+  it("resolves names polluted by XML fragments", () => {
+    expect(resolveToolName("Read</arg_value>", tools)).toBe("Read");
+    expect(resolveToolName("<tool_call>Bash", tools)).toBe("Bash");
+  });
+
+  it("resolves duplicated names to the longest matching tool", () => {
+    expect(resolveToolName("BashBashBash", tools)).toBe("Bash");
+    expect(resolveToolName("EditExistingFileEditExistingFile", tools)).toBe(
+      "EditExistingFile",
+    );
+  });
+
+  it("returns undefined for unknown tools", () => {
+    expect(resolveToolName("Nonexistent", tools)).toBeUndefined();
+  });
+
+  it("maps read-only CLI/GUI names without mapping write tools", () => {
+    expect(resolveToolName("Read</arg_value>", ["read_file"])).toBe(
+      "read_file",
+    );
+    expect(resolveToolName("read_file", ["Read"])).toBe("Read");
+    expect(resolveToolName("Write", ["create_new_file"])).toBeUndefined();
+  });
+});
+
+describe("tryParseToolArguments", () => {
+  it("parses JSON followed by a trailing XML closing tag", () => {
+    expect(
+      tryParseToolArguments('{"filepath":"a.ts","content":"x"}</arg_value>'),
+    ).toEqual({ filepath: "a.ts", content: "x" });
+  });
+
+  it("parses JSON preceded by XML tags", () => {
+    expect(
+      tryParseToolArguments('<tool_call>{"filepath":"a.ts"}</tool_call>'),
+    ).toEqual({ filepath: "a.ts" });
+  });
+
+  it("parses GLM XML argument pairs", () => {
+    expect(
+      tryParseToolArguments(
+        "<arg_key>filepath</arg_key><arg_value>a.ts</arg_value>" +
+          "<arg_key>offset</arg_key><arg_value>12</arg_value>",
+      ),
+    ).toEqual({ filepath: "a.ts", offset: 12 });
+  });
+
+  it("keeps XML keys when the value itself is JSON", () => {
+    expect(
+      tryParseToolArguments(
+        '<arg_key>arguments</arg_key><arg_value>{"a":1}</arg_value>',
+      ),
+    ).toEqual({ arguments: { a: 1 } });
+  });
+
+  it("parses Qwen XML parameter pairs", () => {
+    expect(
+      tryParseToolArguments("<parameter=filepath>a.ts</parameter>"),
+    ).toEqual({ filepath: "a.ts" });
+  });
+
+  it("returns undefined while JSON is still streaming", () => {
+    expect(tryParseToolArguments('{"filepath":"a.')).toBeUndefined();
+  });
+});
+
+describe("stripTrailingXmlTags", () => {
+  it("removes only trailing XML tags", () => {
+    expect(stripTrailingXmlTags('{"a":1}</arg_value>')).toBe('{"a":1}');
+    expect(stripTrailingXmlTags('{"a":"</arg_value>"}')).toBe(
+      '{"a":"</arg_value>"}',
+    );
+  });
+});
+
+describe("normalizeToolArguments", () => {
+  const readSchema = {
+    properties: { filepath: { type: "string" } },
+    required: ["filepath"],
+  };
+
+  it("maps file_path to filepath for Read", () => {
+    expect(normalizeToolArguments({ file_path: "a.ts" }, readSchema)).toEqual({
+      filepath: "a.ts",
+    });
+  });
+
+  it("maps path to filepath when path is not a schema property", () => {
+    expect(normalizeToolArguments({ path: "a.ts" }, readSchema)).toEqual({
+      filepath: "a.ts",
+    });
+  });
+
+  it("does not steal a real schema property as an alias", () => {
+    const grepSchema = {
+      properties: { pattern: { type: "string" }, path: { type: "string" } },
+    };
+    expect(normalizeToolArguments({ path: "src" }, grepSchema)).toEqual({
+      path: "src",
+    });
+  });
+
+  it("leaves canonical arguments untouched", () => {
+    expect(normalizeToolArguments({ filepath: "a.ts" }, readSchema)).toEqual({
+      filepath: "a.ts",
+    });
+  });
+});
