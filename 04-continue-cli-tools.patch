+import { describe, expect, it } from "vitest";
+
+import { processToolCallDelta } from "./streamChatResponse.helpers.js";
+import { ToolCall } from "../tools/types.js";
+
+function process(deltas: any[]): Map<string, ToolCall> {
+  const toolCalls = new Map<string, ToolCall>();
+  const indexToId = new Map<number, string>();
+  for (const delta of deltas) {
+    processToolCallDelta(delta, toolCalls, indexToId);
+  }
+  return toolCalls;
+}
+
+describe("processToolCallDelta - malformed provider payloads", () => {
+  it("keeps the Read name when a closing XML tag arrives as a name delta", () => {
+    const calls = process([
+      {
+        index: 0,
+        id: "call_1",
+        function: {
+          name: "Read",
+          arguments: '{"filepath":"/tmp/a.txt"}',
+        },
+      },
+      {
+        index: 0,
+        function: {
+          name: "</arg_value>",
+        },
+      },
+    ]);
+
+    const call = calls.get("call_1");
+    expect(call?.name).toBe("Read");
+    expect(call?.arguments).toEqual({ filepath: "/tmp/a.txt" });
+  });
+
+  it("recovers JSON arguments followed by a closing XML tag", () => {
+    const calls = process([
+      {
+        index: 0,
+        id: "call_1",
+        function: {
+          name: "Read",
+          arguments: '{"filepath":"/tmp/a.txt"}</arg_value>',
+        },
+      },
+    ]);
+
+    expect(calls.get("call_1")?.arguments).toEqual({
+      filepath: "/tmp/a.txt",
+    });
+  });
+
+  it("parses GLM XML argument pairs", () => {
+    const calls = process([
+      {
+        index: 0,
+        id: "call_1",
+        function: {
+          name: "Read",
+          arguments:
+            "<arg_key>filepath</arg_key><arg_value>/tmp/a.txt</arg_value>",
+        },
+      },
+    ]);
+
+    expect(calls.get("call_1")?.arguments).toEqual({
+      filepath: "/tmp/a.txt",
+    });
+  });
+
