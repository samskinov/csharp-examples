@@ -0,0 +1,386 @@
+/**
+ * Defensive normalisation for tool calls produced by OpenAI-compatible
+ * providers.
+ *
+ * Some providers (notably LiteLLM/Ollama bridges in front of GLM models)
+ * leak fragments of the model's native XML tool-call syntax into the streamed
+ * OpenAI `tool_calls` payload. The two symptoms seen in practice are:
+ *
+ *   name:      "Read</arg_value>"        (lookup fails: Tool ... not found)
+ *   arguments: '{"filepath":"a.ts"}</arg_value>' (JSON.parse fails)
+ *
+ * The helpers below never throw: they recover the usable tool name and
+ * arguments so a corrupted stream does not break the whole turn.
+ */
+
+const XML_TAG = /<[^>]*>/g;
+const TRAILING_XML_TAG = /(?:\s*<\/[a-zA-Z_][\w:-]*>\s*)+$/g;
+
+/**
+ * Removes XML tool-call fragments from a tool name and keeps the first token.
+ *
+ * Examples:
+ *   "<tool_call>Read"      -> "Read"
+ *   "Read</arg_value>"     -> "Read"
+ *   "<function=Read>"      -> "Read"
+ *   "</arg_value>"         -> ""
+ */
+export function sanitizeToolName(rawName: string | undefined): string {
+  if (!rawName) {
+    return "";
+  }
+
+  // Qwen/GLM sometimes wrap the name as <function=Read> or <function name="Read">
+  const functionTag = rawName.match(
+    /<function\s*(?:=\s*|name\s*=\s*)["']?([^"'>\s]+)/i,
+  );
+  if (functionTag?.[1]) {
+    return functionTag[1].replace(/^[`"']+|[`"']+$/g, "");
+  }
+
+  let name = rawName.replace(XML_TAG, " ").trim();
+  name = name.replace(/^(?:name|function)\s*=\s*/i, "");
+  // Tool names never contain whitespace: anything after the first token is
+  // XML garbage or a provider annotation.
+  name = name.split(/\s+/)[0] ?? "";
+  return name.replace(/^[`"']+|[`"']+$/g, "");
+}
+
+/**
+ * Merges a streamed tool-name delta with the name accumulated so far.
+ * Handles full-name repeats, progressive prefixes and plain fragments, and
+ * ignores fragments that are only XML closing tags.
+ */
+export function mergeToolName(current: string, delta: string): string {
+  const nameDelta = sanitizeToolName(delta);
+  if (!nameDelta) {
+    return current;
+  }
+  if (!current) {
+    return nameDelta;
+  }
+  if (nameDelta === current) {
+    return current;
+  }
+  // Provider streams the full name again, progressively
+  if (nameDelta.startsWith(current)) {
+    return nameDelta;
+  }
+  // Duplicate partial name chunk
+  if (current.startsWith(nameDelta)) {
+    return current;
+  }
+  return current + nameDelta;
+}
+
+/**
+ * Read-only tool names that differ between the CLI and the VS Code GUI.
+ * Only read-only tools are mapped: inventing a write/edit target from a name
+ * mismatch could modify the wrong file.
+ */
+const READ_ONLY_TOOL_ALIASES: Record<string, readonly string[]> = {
+  read_file: ["Read", "readFile", "read"],
+  read_file_range: ["ReadRange", "readRange"],
+  ls: ["List", "listFiles", "list"],
+  grep_search: ["Grep", "Search", "grep"],
+  file_glob_search: ["Glob", "glob"],
+  fetch_url_content: ["Fetch", "fetchUrl"],
+  view_diff: ["Diff", "viewDiff"],
+  read_currently_open_file: ["ReadCurrentlyOpenFile"],
+};
+
+function findReadOnlyAlias(
+  name: string,
+  availableNames: readonly string[],
+): string | undefined {
+  const lower = name.toLowerCase();
+
+  for (const [canonical, aliases] of Object.entries(READ_ONLY_TOOL_ALIASES)) {
+    const canonicalAvailable = availableNames.find(
+      (available) => available.toLowerCase() === canonical,
+    );
+    if (
+      canonicalAvailable &&
+      (lower === canonical ||
+        aliases.some((alias) => alias.toLowerCase() === lower))
+    ) {
+      return canonicalAvailable;
+    }
+
+    const aliasAvailable = availableNames.find((available) =>
+      aliases.some((alias) => alias.toLowerCase() === available.toLowerCase()),
+    );
+    if (aliasAvailable && lower === canonical) {
+      return aliasAvailable;
+    }
+  }
+
+  return undefined;
+}
+
+/**
+ * Finds the canonical tool name even when a provider polluted it with XML
+ * fragments or duplicated it ("BashBashBash").
+ */
+export function resolveToolName(
+  rawName: string | undefined,
+  availableNames: readonly string[],
+): string | undefined {
+  if (!rawName) {
+    return undefined;
+  }
+
+  const sanitized = sanitizeToolName(rawName);
+  const candidates = Array.from(new Set([rawName, sanitized].filter(Boolean)));
+
+  for (const candidate of candidates) {
+    const exact = availableNames.find((name) => name === candidate);
+    if (exact) {
+      return exact;
+    }
+  }
+
+  for (const candidate of candidates) {
+    const caseInsensitive = availableNames.find(
+      (name) => name.toLowerCase() === candidate.toLowerCase(),
+    );
+    if (caseInsensitive) {
+      return caseInsensitive;
+    }
+  }
+
+  const readOnlyAlias = findReadOnlyAlias(sanitized, availableNames);
+  if (readOnlyAlias) {
+    return readOnlyAlias;
+  }
+
+  // Longest first so that e.g. "ReadFile" wins over "Read".
+  const byLength = [...availableNames].sort((a, b) => b.length - a.length);
+
+  // Corrupted name that starts with a known tool ("BashBash" -> "Bash")
+  const prefixed = byLength.find(
+    (name) =>
+      sanitized.length > name.length &&
+      sanitized.toLowerCase().startsWith(name.toLowerCase()),
+  );
+  if (prefixed) {
+    return prefixed;
+  }
+
+  // Known tool embedded in the corrupted name.
+  if (sanitized.length >= 3) {
+    const embedded = byLength.find((name) =>
+      sanitized.toLowerCase().includes(name.toLowerCase()),
+    );
+    if (embedded) {
+      return embedded;
+    }
+  }
+
+  return undefined;
+}
+
+/**
+ * Extracts the first complete JSON object/array from a string, ignoring any
+ * XML tags before or after it. Returns undefined when no complete value is
+ * present (e.g. while arguments are still streaming).
+ */
+function extractJsonValue(raw: string): string | undefined {
+  const start = raw.search(/[\[{]/);
+  if (start === -1) {
+    return undefined;
+  }
+
+  const opening = raw[start];
+  const closing = opening === "{" ? "}" : "]";
+  let depth = 0;
+  let inString = false;
+  let escaped = false;
+
+  for (let i = start; i < raw.length; i++) {
+    const char = raw[i];
+
+    if (inString) {
+      if (escaped) {
+        escaped = false;
+      } else if (char === "\\") {
+        escaped = true;
+      } else if (char === '"') {
+        inString = false;
+      }
+      continue;
+    }
+
+    if (char === '"') {
+      inString = true;
+    } else if (char === opening) {
+      depth++;
+    } else if (char === closing) {
+      depth--;
+      if (depth === 0) {
+        return raw.slice(start, i + 1);
+      }
+    }
+  }
+
+  return undefined;
+}
+
+function decodeXmlEntities(value: string): string {
+  return value
+    .replace(/&lt;/g, "<")
+    .replace(/&gt;/g, ">")
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;|&apos;/g, "'")
+    .replace(/&amp;/g, "&");
+}
+
+function parseXmlArgValue(value: string): unknown {
+  const decoded = decodeXmlEntities(value.trim());
+  try {
+    return JSON.parse(decoded);
+  } catch {
+    return decoded;
+  }
+}
+
+/**
+ * Parses GLM-style `<arg_key>...</arg_key><arg_value>...</arg_value>` pairs
+ * when a provider forwards the model's XML directly.
+ */
+function parseXmlToolArguments(raw: string): Record<string, any> | undefined {
+  const args: Record<string, any> = {};
+
+  const glmPairs =
+    /<arg_key>\s*([\s\S]*?)\s*<\/arg_key>\s*<arg_value>\s*([\s\S]*?)\s*<\/arg_value>/gi;
+  for (const match of raw.matchAll(glmPairs)) {
+    const key = decodeXmlEntities(match[1].trim());
+    if (key) {
+      args[key] = parseXmlArgValue(match[2]);
+    }
+  }
+
+  // Qwen-style <parameter=name>value</parameter>
+  const qwenPairs = /<parameter=([^>]+)>([\s\S]*?)<\/parameter>/gi;
+  for (const match of raw.matchAll(qwenPairs)) {
+    const key = match[1].trim();
+    if (key) {
+      args[key] = parseXmlArgValue(match[2]);
+    }
+  }
+
+  return Object.keys(args).length > 0 ? args : undefined;
+}
+
+/**
+ * Best-effort parse of tool-call arguments.
+ * Returns undefined when the string is not a complete JSON object yet and
+ * does not contain XML argument pairs.
+ */
+export function tryParseToolArguments(
+  raw: unknown,
+): Record<string, any> | undefined {
+  if (raw && typeof raw === "object" && !Array.isArray(raw)) {
+    return raw as Record<string, any>;
+  }
+  if (typeof raw !== "string") {
+    return undefined;
+  }
+
+  const trimmed = raw.trim();
+  if (!trimmed) {
+    return undefined;
+  }
+
+  // Prefer the XML pair parser when the model used its native syntax: a JSON
+  // value inside <arg_value> must not be mistaken for the whole arguments
+  // object.
+  if (/<arg_key\b/i.test(trimmed) || /<parameter=/i.test(trimmed)) {
+    const xmlArgs = parseXmlToolArguments(trimmed);
+    if (xmlArgs) {
+      return xmlArgs;
+    }
+  }
+
+  const json = extractJsonValue(trimmed);
+  if (json) {
+    try {
+      const parsed = JSON.parse(json);
+      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
+        return parsed;
+      }
+    } catch {
+      // Not complete yet; fall through to the XML parser.
+    }
+  }
+
+  return parseXmlToolArguments(trimmed);
+}
+
+/**
+ * Removes trailing XML closing tags from a complete or partial arguments
+ * string. Used when a provider appends the model's native syntax after the
+ * JSON object.
+ */
+export function stripTrailingXmlTags(raw: string): string {
+  return raw.replace(TRAILING_XML_TAG, "").trim();
+}
+
+/**
+ * Common alternative argument names used by models for the built-in tools.
+ * The canonical name is the Continue tool schema; aliases are only applied
+ * when the canonical key is absent and the alias is not itself a property of
+ * the tool schema (so e.g. Grep's "path" is never turned into "pattern").
+ */
+const ARGUMENT_ALIASES: Record<string, readonly string[]> = {
+  filepath: ["file_path", "filePath", "path", "filename", "file"],
+  file_path: ["filepath", "filePath", "path", "filename", "file"],
+  old_string: ["old_str", "oldText", "old_text"],
+  new_string: ["new_str", "newText", "new_text"],
+  command: ["cmd"],
+  pattern: ["query", "regex"],
+  content: ["contents", "text"],
+};
+
+/**
+ * Repairs common argument-name mismatches (e.g. a model calling Read with
+ * "file_path" instead of "filepath"). Unknown arguments are preserved.
+ */
+export function normalizeToolArguments(
+  args: Record<string, any> | undefined,
+  schema?: {
+    properties?: Record<string, any>;
+    required?: readonly string[];
+  },
+): Record<string, any> {
+  if (!args || typeof args !== "object" || Array.isArray(args)) {
+    return args ?? {};
+  }
+
+  const properties = schema?.properties;
+  const normalized: Record<string, any> = { ...args };
+  const canonicalKeys = properties
+    ? Object.keys(properties)
+    : Object.keys(ARGUMENT_ALIASES);
+
+  for (const canonical of canonicalKeys) {
+    if (normalized[canonical] !== undefined) {
+      continue;
+    }
+    const aliases = ARGUMENT_ALIASES[canonical];
+    if (!aliases) {
+      continue;
+    }
+    const alias = aliases.find(
+      (candidate) =>
+        normalized[candidate] !== undefined &&
+        !(properties && candidate in properties),
+    );
+    if (alias !== undefined) {
+      normalized[canonical] = normalized[alias];
+      delete normalized[alias];
+    }
+  }
+
+  return normalized;
+}
