 extensions/cli/src/messageConversion.test.ts  | 70 ++++++++++++++++++-
 .../cli/src/stream/streamChatResponse.ts      | 13 ++--
 .../cli/src/stream/streamResilience.test.ts   | 66 +++++++++++++++++
 extensions/cli/src/stream/streamResilience.ts | 15 +++-
 5 files changed, 174 insertions(+), 19 deletions(-)

diff --git a/core/util/messageConversion.ts b/core/util/messageConversion.ts
index 0712b4d90..0e86e2109 100644
--- a/core/util/messageConversion.ts
+++ b/core/util/messageConversion.ts
@@ -362,19 +362,24 @@ export function convertFromUnifiedHistoryWithSystemMessage(
   historyItems: ChatHistoryItem[],
   systemMessage: string,
 ): ChatCompletionMessageParam[] {
-  const messages: ChatCompletionMessageParam[] = [];
-
-  // Inject system message at the beginning
-  messages.push({
-    role: "system",
-    content: systemMessage,
-  });
-
-  // Convert the rest of the history
-  const convertedMessages = convertFromUnifiedHistory(historyItems);
-  messages.push(...convertedMessages);
+  // OpenAI-compatible providers only accept a system message at the very
+  // beginning, and litellm rejects any payload where one appears later. The
+  // CLI appends system-role items to the history for display purposes
+  // (errors, cancelled tools, compaction notices), and serve/resume can carry
+  // a stale system prompt. The system message passed here is always the
+  // current, authoritative one, so drop every system item from the history
+  // and inject exactly one at index 0.
+  const conversationHistory = historyItems.filter(
+    (item) => item.message.role !== "system",
+  );
 
-  return messages;
+  return [
+    {
+      role: "system",
+      content: systemMessage,
+    },
+    ...convertFromUnifiedHistory(conversationHistory),
+  ];
 }
 
