+import { describe, expect, it } from "vitest";
+
+import { Tool } from "./types.js";
+import {
+  buildToolCallRejectionMessage,
+  buildToolUsageReminderForCliTool,
+  validateToolArguments,
+} from "./validateToolArgs.js";
+
+const testTool: Tool = {
+  name: "Read",
+  displayName: "Read",
+  description: "Read a file",
+  parameters: {
+    type: "object",
+    required: ["filepath"],
+    properties: {
+      filepath: { type: "string", description: "The path to read" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async () => "",
+};
+
+describe("tool argument errors", () => {
+  it("uses the text tool fence in text mode", () => {
+    const reminder = buildToolUsageReminderForCliTool(testTool, "text");
+    expect(reminder).toContain("```tool");
+    expect(reminder).toContain('"filepath": "path/to/file.ts"');
+  });
+
+  it("does not prescribe a text fence in native mode", () => {
+    const reminder = buildToolUsageReminderForCliTool(testTool, "native");
+    expect(reminder).not.toContain("```tool");
+    expect(reminder).toContain("Example arguments (JSON)");
+    expect(reminder).toContain('"filepath": "path/to/file.ts"');
+  });
+
+  it("includes the corrected arguments in the rejection message", () => {
+    const issues = validateToolArguments(testTool, {});
+    const message = buildToolCallRejectionMessage(
+      testTool,
+      {},
+      issues,
+      "native",
+    );
+
+    expect(message).toContain("missing required parameter");
+    expect(message).toContain("Example arguments (JSON)");
+    expect(message).not.toContain("```tool");
+  });
+});
diff --git a/extensions/cli/src/tools/validateToolArgs.ts b/extensions/cli/src/tools/validateToolArgs.ts
new file mode 100644
index 000000000..73bc2b6d3
--- /dev/null
+++ b/extensions/cli/src/tools/validateToolArgs.ts
@@ -0,0 +1,163 @@
+import type { ToolMode } from "../permissions/types.js";
+
+import {
+  buildToolArgumentExample,
+  buildToolCallExample,
+} from "./textToolMode.js";
+import { Tool } from "./types.js";
+
+export interface ToolArgumentIssue {
+  path: string;
+  message: string;
+}
+
+function isPlainObject(value: unknown): value is Record<string, any> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function validateValue(
+  value: unknown,
+  schema: any,
+  path: string,
+  issues: ToolArgumentIssue[],
+): void {
+  if (!schema) {
+    return;
+  }
+
+  const expectedType = schema.type;
+  if (expectedType === "object") {
+    if (!isPlainObject(value)) {
+      issues.push({ path, message: "must be a JSON object" });
+      return;
+    }
+    const properties = schema.properties ?? {};
+    for (const required of schema.required ?? []) {
+      if (value[required] === undefined || value[required] === null) {
+        issues.push({
+          path: path ? `${path}.${required}` : required,
+          message: "missing required parameter",
+        });
+      }
+    }
+    for (const [key, childSchema] of Object.entries(properties)) {
+      if (value[key] !== undefined && value[key] !== null) {
+        validateValue(
+          value[key],
+          childSchema,
+          path ? `${path}.${key}` : key,
+          issues,
+        );
+      }
+    }
+    return;
+  }
+
+  if (expectedType === "array") {
+    if (!Array.isArray(value)) {
+      issues.push({ path, message: "must be an array" });
+      return;
+    }
+    if (schema.items) {
+      value.forEach((item, index) =>
+        validateValue(item, schema.items, `${path}[${index}]`, issues),
+      );
+    }
+    return;
+  }
+
+  if (expectedType === "string" && typeof value !== "string") {
+    issues.push({ path, message: "must be a string" });
+  } else if (expectedType === "number" && typeof value !== "number") {
+    issues.push({ path, message: "must be a number" });
+  } else if (
+    expectedType === "integer" &&
+    (typeof value !== "number" || !Number.isSafeInteger(value))
+  ) {
+    issues.push({ path, message: "must be an integer" });
+  } else if (expectedType === "boolean" && typeof value !== "boolean") {
+    issues.push({ path, message: "must be a boolean" });
+  }
+}
+
+export function validateToolArguments(
+  tool: Tool,
+  args: Record<string, any>,
+): ToolArgumentIssue[] {
+  const issues: ToolArgumentIssue[] = [];
+  validateValue(args, tool.parameters, "", issues);
+  return issues;
+}
+
+export function buildToolUsageReminderForCliTool(
+  tool: Tool,
+  toolMode: ToolMode = "text",
+): string {
+  const required = tool.parameters.required?.length
+    ? tool.parameters.required.join(", ")
+    : "none";
+
+  if (toolMode === "native") {
+    return [
+      `Tool usage reminder for "${tool.name}":`,
+      `Required: ${required}`,
+      "Example arguments (JSON):",
+      JSON.stringify(buildToolArgumentExample(tool.parameters), null, 2),
+      "Call the tool again using the same native tool-calling interface, with all required arguments.",
+    ].join("\n");
+  }
+
+  return [
+    `Tool usage reminder for "${tool.name}":`,
+    `Required: ${required}`,
+    "Example:",
+    "```tool",
+    buildToolCallExample({
+      name: tool.name,
+      description: tool.description,
+      parameters: tool.parameters,
+    }),
+    "```",
+    "Call the tool again with this syntax and all required arguments.",
+  ].join("\n");
+}
+
+export function buildToolCallRejectionMessage(
+  tool: Tool,
+  args: Record<string, any>,
+  issues: ToolArgumentIssue[],
+  toolMode: ToolMode = "text",
+): string {
+  const problemLines = issues
+    .map((issue) => `- ${issue.path}: ${issue.message}`)
+    .join("\n");
+  const required = tool.parameters.required?.length
+    ? tool.parameters.required.join(", ")
+    : "none";
+
+  return [
+    `Tool call rejected before execution: "${tool.name}".`,
+    `Arguments received: ${JSON.stringify(args)}`,
+    "",
+    "Problems:",
+    problemLines || "- invalid arguments",
+    "",
+    `Required: ${required}`,
+    `Schema: ${JSON.stringify(tool.parameters)}`,
+    "",
+    toolMode === "native" ? "Example arguments (JSON):" : "Correct example:",
+    ...(toolMode === "native"
+      ? [JSON.stringify(buildToolArgumentExample(tool.parameters), null, 2)]
+      : [
+          "```tool",
+          buildToolCallExample({
+            name: tool.name,
+            description: tool.description,
+            parameters: tool.parameters,
+          }),
+          "```",
+        ]),
+    "",
+    "Fix the arguments and call the tool again. Do not repeat the same invalid call.",
+  ].join("\n");
+}
