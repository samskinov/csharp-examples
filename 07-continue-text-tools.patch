+  async waitForConnections(timeoutMs = 8000): Promise<void> {
+    // Wait at most once per refresh. Otherwise a single hanging MCP server
+    // would add its full timeout to every subsequent request.
+    if (this.hasWaitedForConnections) {
+      return;
+    }
+    this.hasWaitedForConnections = true;
+
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    try {
+      await Promise.race([
+        this.refreshPromise.catch(() => undefined),
+        new Promise<void>((resolve) => {
+          timer = setTimeout(resolve, timeoutMs);
+          // Never keep the extension host alive just for this bounded wait.
+          (timer as any).unref?.();
+        }),
+      ]);
+    } finally {
+      if (timer) {
+        clearTimeout(timer);
+      }
+    }
+  }
+
