+import { applyWorkspaceChange } from "../util/workspace.js";
+
+import { Tool } from "./types.js";
+
+export const changeDirectoryTool: Tool = {
+  name: "ChangeDirectory",
+  displayName: "Change Directory",
+  description:
+    "Change the persistent working directory for this session. Use this instead of `cd` in Bash: a cd inside Bash only affects that one command.",
+  parameters: {
+    type: "object",
+    required: ["path"],
+    properties: {
+      path: {
+        type: "string",
+        description:
+          "Directory to switch to. Supports absolute paths, relative paths and ~/.",
+      },
+    },
+  },
+  readonly: false,
+  isBuiltIn: true,
+  preprocess: async (args) => ({
+    args,
+    preview: [
+      {
+        type: "text",
+        content: `Will change the working directory to ${args.path}`,
+      },
+    ],
+  }),
+  run: async ({ path }: { path: string }): Promise<string> => {
+    const result = await applyWorkspaceChange(path);
+    if (!result.success || !result.path) {
+      throw new Error(result.message);
+    }
+    return `Working directory changed to ${result.path}`;
+  },
+};
