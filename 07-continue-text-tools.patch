diff --git a/gui/src/redux/util/toolDeclarationMode.test.ts b/gui/src/redux/util/toolDeclarationMode.test.ts
new file mode 100644
index 000000000..9d390f533
--- /dev/null
+++ b/gui/src/redux/util/toolDeclarationMode.test.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+
+import type { RootState } from "../store";
+
+import { getToolDeclarationMode } from "./toolDeclarationMode";
+
+function makeState(
+  model: Record<string, any>,
+  onlyUseSystemMessageTools?: boolean,
+): RootState {
+  return {
+    config: {
+      config: {
+        selectedModelByRole: { chat: model },
+        experimental: { onlyUseSystemMessageTools },
+      },
+    },
+  } as unknown as RootState;
+}
+
+describe("getToolDeclarationMode", () => {
+  const nativeModel = {
+    provider: "openai",
+    model: "gpt-4o",
+    capabilities: { tools: true },
+  };
+
+  it("honours the explicit text override", () => {
+    expect(getToolDeclarationMode(makeState(nativeModel, true))).toBe("text");
+  });
+
+  it("honours the explicit native override", () => {
+    expect(getToolDeclarationMode(makeState(nativeModel, false))).toBe(
+      "native",
+    );
+  });
+
+  it("uses text mode for local Ollama", () => {
+    expect(
+      getToolDeclarationMode(makeState({ ...nativeModel, provider: "ollama" })),
+    ).toBe("text");
+  });
+
+  it("uses text mode for a custom OpenAI-compatible endpoint", () => {
+    expect(
+      getToolDeclarationMode(
