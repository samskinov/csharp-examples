@@ -0,0 +1,138 @@
+import { describe, expect, it } from "vitest";
+
+import { Tool } from "..";
+import {
+  buildToolCallRejectionMessage,
+  buildToolUsageReminder,
+  validateToolArguments,
+} from "./toolArgumentValidation";
+
+function tool(parameters: any): Tool {
+  return {
+    type: "function",
+    displayTitle: "Test",
+    wouldLikeTo: "",
+    isCurrently: "",
+    hasAlready: "",
+    readonly: false,
+    isInstant: true,
+    group: "built-in",
+    function: {
+      name: "TestTool",
+      description: "Test tool",
+      parameters,
+    },
+  } as Tool;
+}
+
+describe("validateToolArguments", () => {
+  it("reports missing top-level required parameters", () => {
+    const issues = validateToolArguments(
+      tool({
+        type: "object",
+        required: ["filepath"],
+        properties: { filepath: { type: "string" } },
+      }),
+      {},
+    );
+
+    expect(issues).toEqual([
+      { path: "filepath", message: "missing required parameter" },
+    ]);
+  });
+
+  it("reports missing required fields inside arrays", () => {
+    const issues = validateToolArguments(
+      tool({
+        type: "object",
+        required: ["edits"],
+        properties: {
+          edits: {
+            type: "array",
+            items: {
+              type: "object",
+              required: ["old_string", "new_string"],
+              properties: {
+                old_string: { type: "string" },
+                new_string: { type: "string" },
+              },
+            },
+          },
+        },
+      }),
+      { edits: [{ old_string: "a" }] },
+    );
+
+    expect(issues).toEqual([
+      { path: "edits[0].new_string", message: "missing required parameter" },
+    ]);
+  });
+
+  it("includes the schema and a concrete example in the rejection", () => {
+    const testTool = tool({
+      type: "object",
+      required: ["filepath"],
+      properties: { filepath: { type: "string" } },
+    });
+    const message = buildToolCallRejectionMessage(
+      testTool,
+      {},
+      validateToolArguments(testTool, {}),
+    );
+
+    expect(message).toContain("Tool call rejected before execution");
+    expect(message).toContain("Required: filepath");
+    expect(message).toContain("Example arguments (JSON)");
+    expect(message).toContain('"filepath": "path/to/file.ts"');
+    expect(message).toContain("Do not repeat the same invalid call");
+  });
+
+  it("shows optional parameters when the tool has no required list", () => {
+    const testTool = tool({
+      type: "object",
+      properties: {
+        filepath: { type: "string" },
+        offset: { type: "number" },
+      },
+    });
+    const message = buildToolCallRejectionMessage(
+      testTool,
+      {},
+      [{ path: "filepath", message: "missing required parameter" }],
+    );
+
+    expect(message).toContain('"filepath"');
+    expect(message).toContain('"offset"');
+  });
+
+  it("uses the session tool syntax in reminders", () => {
+    const testTool = tool({
+      type: "object",
+      required: ["filepath"],
+      properties: { filepath: { type: "string" } },
+    });
+
+    const textReminder = buildToolUsageReminder(testTool, "text");
+    expect(textReminder).toContain("TOOL_NAME: TestTool");
+    expect(textReminder).toContain("BEGIN_ARG: filepath");
+    expect(textReminder).toContain("END_ARG");
+
+    const nativeReminder = buildToolUsageReminder(testTool, "native");
+    expect(nativeReminder).toContain("Example arguments (JSON)");
+    expect(nativeReminder).not.toContain("BEGIN_ARG");
+    expect(nativeReminder).toContain('"filepath": "path/to/file.ts"');
+  });
+
+  it("rejects non-integer values for integer schemas", () => {
+    const issues = validateToolArguments(
+      tool({
+        type: "object",
+        required: ["count"],
+        properties: { count: { type: "integer" } },
+      }),
+      { count: 1.5 },
+    );
+
+    expect(issues).toEqual([{ path: "count", message: "must be an integer" }]);
+  });
+});
