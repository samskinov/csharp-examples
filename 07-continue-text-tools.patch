@@ -0,0 +1,74 @@
+import { createRef } from "react";
+
+import { render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import type { ChatHistoryItemWithMessageId } from "../../redux/slices/sessionSlice";
+
+import { VirtualizedHistory } from "./VirtualizedHistory";
+
+class MockResizeObserver {
+  observe() {}
+  unobserve() {}
+  disconnect() {}
+}
+
+function makeItems(count: number): ChatHistoryItemWithMessageId[] {
+  return Array.from({ length: count }, (_, index) => ({
+    message: {
+      id: `message-${index}`,
+      role: index % 2 === 0 ? "user" : "assistant",
+      content: `message ${index}`,
+    },
+    contextItems: [],
+  })) as ChatHistoryItemWithMessageId[];
+}
+
+function renderHistory(items: ChatHistoryItemWithMessageId[]) {
+  const scrollRef = createRef<HTMLDivElement>();
+  render(
+    <div ref={scrollRef}>
+      <VirtualizedHistory
+        scrollRef={scrollRef}
+        header={<div>header</div>}
+        footer={<div>footer</div>}
+        items={items}
+        renderItem={(item) => (
+          <div data-testid="row">{item.message.id}</div>
+        )}
+      />
+    </div>,
+  );
+}
+
+describe("VirtualizedHistory", () => {
+  beforeEach(() => {
+    vi.stubGlobal("ResizeObserver", MockResizeObserver);
+    vi.stubGlobal("requestAnimationFrame", (callback: FrameRequestCallback) => {
+      return setTimeout(() => callback(0), 0) as unknown as number;
+    });
+    vi.stubGlobal("cancelAnimationFrame", (id: number) => clearTimeout(id));
+  });
+
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  it("keeps small conversations fully rendered for find-in-page", () => {
+    renderHistory(makeItems(100));
+
+    expect(screen.getAllByTestId("row")).toHaveLength(100);
+    expect(screen.getByText("header")).toBeTruthy();
+    expect(screen.getByText("footer")).toBeTruthy();
+  });
+
+  it("mounts only the visible window for long conversations", () => {
+    renderHistory(makeItems(150));
+
+    const rows = screen.getAllByTestId("row");
+    expect(rows.length).toBeGreaterThan(0);
+    expect(rows.length).toBeLessThan(150);
+    expect(screen.getByText("header")).toBeTruthy();
+    expect(screen.getByText("footer")).toBeTruthy();
+  });
+});
