new file mode 100644
index 000000000..ea694e64e
--- /dev/null
+++ b/core/tools/toolArgumentValidation.ts
@@ -0,0 +1,223 @@
+import { Tool } from "..";
+
+export interface ToolArgumentIssue {
+  path: string;
+  message: string;
+}
+
+function isPlainObject(value: unknown): value is Record<string, any> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function validateValue(
+  value: unknown,
+  schema: any,
+  path: string,
+  issues: ToolArgumentIssue[],
+): void {
+  if (!schema) return;
+
+  if (schema.type === "object") {
+    if (!isPlainObject(value)) {
+      issues.push({ path, message: "must be a JSON object" });
+      return;
+    }
+    for (const required of schema.required ?? []) {
+      if (value[required] === undefined || value[required] === null) {
+        issues.push({
+          path: path ? `${path}.${required}` : required,
+          message: "missing required parameter",
+        });
+      }
+    }
+    for (const [key, childSchema] of Object.entries(
+      schema.properties ?? {},
+    )) {
+      if (value[key] !== undefined && value[key] !== null) {
+        validateValue(
+          value[key],
+          childSchema,
+          path ? `${path}.${key}` : key,
+          issues,
+        );
+      }
+    }
+    return;
+  }
+
+  if (schema.type === "array") {
+    if (!Array.isArray(value)) {
+      issues.push({ path, message: "must be an array" });
+      return;
+    }
+    if (schema.items) {
+      value.forEach((item, index) =>
+        validateValue(item, schema.items, `${path}[${index}]`, issues),
+      );
+    }
+    return;
+  }
+
+  if (schema.type === "string" && typeof value !== "string") {
+    issues.push({ path, message: "must be a string" });
+  } else if (schema.type === "number" && typeof value !== "number") {
+    issues.push({ path, message: "must be a number" });
+  } else if (
+    schema.type === "integer" &&
+    (typeof value !== "number" || !Number.isSafeInteger(value))
+  ) {
+    issues.push({ path, message: "must be an integer" });
+  } else if (schema.type === "boolean" && typeof value !== "boolean") {
+    issues.push({ path, message: "must be a boolean" });
+  }
+}
+
+export function validateToolArguments(
+  tool: Tool,
+  args: Record<string, any>,
+): ToolArgumentIssue[] {
+  const issues: ToolArgumentIssue[] = [];
+  validateValue(args, tool.function.parameters, "", issues);
+  return issues;
+}
+
+function sampleValue(name: string, schema: any): any {
+  if (schema?.enum?.length) return schema.enum[0];
+  switch (schema?.type) {
+    case "string": {
+      const samples: Record<string, string> = {
+        filepath: "path/to/file.ts",
+        file_path: "path/to/file.ts",
+        path: "path/to/file.ts",
+        dirPath: "path/to/directory",
+        dirpath: "path/to/directory",
+        directory_path: "path/to/directory",
+        old_string: "exact existing text",
+        new_string: "replacement text",
+        content: "file content",
+        command: "npm test",
+        pattern: "search pattern",
+        query: "search query",
+        patch:
+          "*** Begin Patch\n*** Update File: path/to/file.ts\n@@\n-old line\n+new line\n*** End Patch",
+        question: "question for the user",
+        url: "https://example.com",
+      };
+      return samples[name] ?? `<${name}>`;
+    }
+    case "number":
+    case "integer":
+      return 1;
+    case "boolean":
+      return false;
+    case "array":
+      return [sampleValue(name, schema.items ?? {})];
+    case "object": {
+      const properties = schema.properties ?? {};
+      const required = schema.required?.length
+        ? schema.required
+        : Object.keys(properties);
+      const value: Record<string, any> = {};
+      for (const key of required) {
+        value[key] = sampleValue(key, properties[key] ?? {});
+      }
+      return value;
+    }
+    default:
+      return `<${name}>`;
+  }
+}
+
+function exampleArguments(tool: Tool): Array<[string, any]> {
+  const parameters = tool.function.parameters;
+  const properties = parameters?.properties ?? {};
+  const required: string[] = parameters?.required?.length
+    ? parameters.required
+    : Object.keys(properties);
+  return required.map((key) => [
+    key,
+    sampleValue(key, properties[key] ?? {}),
+  ]);
+}
+
+function exampleArgumentsObject(tool: Tool): Record<string, any> {
+  return Object.fromEntries(exampleArguments(tool));
+}
+
+/**
+ * The GUI parses the TOOL_NAME/BEGIN_ARG/END_ARG codeblock format (see
+ * SystemMessageToolCodeblocksFramework) when text tool mode is active. Native
+ * mode keeps the API's function-calling format, so the reminder must not
+ * prescribe a text block there.
+ */
+function formatSystemToolExample(tool: Tool): string[] {
+  const lines = ["```tool", `TOOL_NAME: ${tool.function.name}`];
+  for (const [key, value] of exampleArguments(tool)) {
+    lines.push(`BEGIN_ARG: ${key}`, JSON.stringify(value), "END_ARG");
+  }
+  lines.push("```");
+  return lines;
+}
+
+export type ToolReminderFormat = "native" | "text";
+
+export function buildToolCallRejectionMessage(
+  tool: Tool,
+  args: Record<string, any>,
+  issues: ToolArgumentIssue[],
+): string {
+  const problemLines = issues
+    .map((issue) => `- ${issue.path}: ${issue.message}`)
+    .join("\n");
+  const required = tool.function.parameters?.required?.length
+    ? tool.function.parameters.required.join(", ")
+    : "none";
+
+  return [
+    `Tool call rejected before execution: "${tool.function.name}".`,
+    `Arguments received: ${JSON.stringify(args)}`,
+    "",
+    "Problems:",
+    problemLines || "- invalid arguments",
+    "",
+    `Required: ${required}`,
+    `Schema: ${JSON.stringify(tool.function.parameters)}`,
+    "",
+    "Example arguments (JSON):",
+    JSON.stringify(exampleArgumentsObject(tool), null, 2),
+    "",
+    "Fix the arguments and call the tool again. Do not repeat the same invalid call.",
+  ].join("\n");
+}
+
+/**
+ * Compact syntax reminder appended to tool execution errors so the model can
+ * correct a call instead of repeating it or falling back to Bash.
+ */
+export function buildToolUsageReminder(
+  tool: Tool,
+  format: ToolReminderFormat = "native",
+): string {
+  const required = tool.function.parameters?.required?.length
+    ? tool.function.parameters.required.join(", ")
+    : "none";
+
+  const example =
+    format === "text"
+      ? [
+          "Example:",
+          ...formatSystemToolExample(tool),
+          "Call the tool again with this syntax and all required arguments.",
+        ]
+      : [
+          "Example arguments (JSON):",
+          JSON.stringify(exampleArgumentsObject(tool), null, 2),
+          "Call the tool again using the same native tool-calling interface, with all required arguments.",
+        ];
+
+  return [
+    `Tool usage reminder for "${tool.function.name}":`,
+    `Required: ${required}`,
+    ...example,
+  ].join("\n");
+}
