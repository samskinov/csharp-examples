diff --git a/gui/src/pages/gui/VirtualizedHistory.tsx b/gui/src/pages/gui/VirtualizedHistory.tsx
new file mode 100644
index 000000000..2739def51
--- /dev/null
+++ b/gui/src/pages/gui/VirtualizedHistory.tsx
@@ -0,0 +1,342 @@
+import {
+  useEffect,
+  useLayoutEffect,
+  useMemo,
+  useRef,
+  useState,
+  type ReactNode,
+  type RefObject,
+} from "react";
+
+import type { ChatHistoryItemWithMessageId } from "../../redux/slices/sessionSlice";
+
+const ESTIMATED_USER_HEIGHT = 96;
+const ESTIMATED_MESSAGE_HEIGHT = 180;
+const OVERSCAN_PX = 600;
+
+interface VirtualizedHistoryProps {
+  scrollRef: RefObject<HTMLDivElement>;
+  header?: ReactNode;
+  footer?: ReactNode;
+  items: ChatHistoryItemWithMessageId[];
+  renderItem: (
+    item: ChatHistoryItemWithMessageId,
+    index: number,
+  ) => ReactNode;
+}
+
+function estimateHeight(item: ChatHistoryItemWithMessageId): number {
+  return item.message.role === "user"
+    ? ESTIMATED_USER_HEIGHT
+    : ESTIMATED_MESSAGE_HEIGHT;
+}
+
+function findIndexAtOffset(offsets: number[], offset: number): number {
+  if (offsets.length === 0) {
+    return 0;
+  }
+  let low = 0;
+  let high = offsets.length - 1;
+  while (low < high) {
+    const mid = Math.ceil((low + high) / 2);
+    if (offsets[mid] <= offset) {
+      low = mid;
+    } else {
+      high = mid - 1;
+    }
+  }
+  return low;
+}
+
+/**
+ * Dependency-free virtualized chat history.
+ *
+ * Only the rows intersecting the viewport (plus a small overscan) are mounted.
+ * Heights are measured with ResizeObserver and remembered by message id, so
+ * markdown, code blocks and streaming content can change height without
+ * rendering the entire conversation. Following the bottom is preserved when
+ * the user has not scrolled up, including while the last message streams.
+ */
+const VIRTUALIZE_AFTER = 100;
+
+/**
+ * Small conversations are cheaper to render as a normal list (and keep all
+ * browser semantics, find-in-page and test behaviour). Long sessions switch
+ * to the dependency-free virtualizer below.
+ */
+export function VirtualizedHistory(props: VirtualizedHistoryProps) {
+  if (props.items.length <= VIRTUALIZE_AFTER) {
+    return (
+      <>
+        {props.header}
+        {props.items.map((item, index) => {
+          return <div key={item.message.id}>{props.renderItem(item, index)}</div>;
+        })}
+        {props.footer}
+      </>
+    );
+  }
+  return <VirtualizedHistoryRows {...props} />;
+}
+
+function VirtualizedHistoryRows({
+  scrollRef,
+  header,
+  footer,
+  items,
+  renderItem,
+}: VirtualizedHistoryProps) {
+  const [measureVersion, setMeasureVersion] = useState(0);
+  const [scrollTop, setScrollTop] = useState(0);
+  const [viewportHeight, setViewportHeight] = useState(0);
+  const [headerHeight, setHeaderHeight] = useState(0);
+
+  const heights = useRef(new Map<string, number>());
+  const observers = useRef(new Map<string, ResizeObserver>());
+  const rowRefs = useRef(new Map<string, (element: HTMLDivElement | null) => void>());
+  // Measurements arrive in batches; each batch triggers one render.
+  const pendingMeasurements = useRef(new Map<string, number>());
+  const measurementFrame = useRef<number | null>(null);
+  const scrollFrame = useRef<number | null>(null);
+  const itemsRef = useRef(items);
+  const startIndexRef = useRef(0);
+  const headerRef = useRef<HTMLDivElement>(null);
+  const followBottom = useRef(true);
+  const previousUserCount = useRef(0);
+
+  itemsRef.current = items;
+
+  const userCount = useMemo(
+    () => items.filter((item) => item.message.role === "user").length,
+    [items],
+  );
+
+  const offsets = useMemo(() => {
+    const result: number[] = [];
+    let offset = 0;
+    for (const item of items) {
+      result.push(offset);
+      offset += heights.current.get(item.message.id) ?? estimateHeight(item);
+    }
+    return result;
+  }, [items, measureVersion]);
+
+  const totalHeight = useMemo(() => {
+    if (items.length === 0) {
+      return 0;
+    }
+    const last = items[items.length - 1];
+    return (
+      offsets[offsets.length - 1] +
+      (heights.current.get(last.message.id) ?? estimateHeight(last))
+    );
+  }, [items, offsets, measureVersion]);
+
+  const relativeScrollTop = Math.max(0, scrollTop - headerHeight);
+  const startIndex = findIndexAtOffset(
+    offsets,
+    relativeScrollTop - OVERSCAN_PX,
+  );
+  const endIndex = Math.min(
+    items.length,
+    findIndexAtOffset(
+      offsets,
+      relativeScrollTop + Math.max(viewportHeight, 400) + OVERSCAN_PX,
+    ) + 1,
+  );
+  startIndexRef.current = startIndex;
+
+  const scrollToBottom = () => {
+    const element = scrollRef.current;
+    if (!element) {
+      return;
+    }
+    element.scrollTop = element.scrollHeight;
+  };
+
+  // Track the viewport and whether the user is at the bottom.
+  useEffect(() => {
+    const element = scrollRef.current;
+    if (!element) {
+      return;
+    }
+
+    const handleScroll = () => {
+      followBottom.current =
+        element.scrollHeight - element.scrollTop - element.clientHeight < 24;
+      // Coalesce scroll-driven renders into one animation frame.
+      if (scrollFrame.current === null) {
+        scrollFrame.current = requestAnimationFrame(() => {
+          scrollFrame.current = null;
+          setScrollTop(element.scrollTop);
+        });
+      }
+    };
+
+    handleScroll();
+    element.addEventListener("scroll", handleScroll, { passive: true });
+    return () => {
+      element.removeEventListener("scroll", handleScroll);
+      if (scrollFrame.current !== null) {
+        cancelAnimationFrame(scrollFrame.current);
+        scrollFrame.current = null;
+      }
+    };
+  }, [scrollRef]);
+
+  useLayoutEffect(() => {
+    const element = scrollRef.current;
+    if (!element) {
+      return;
+    }
+
+    const observer = new ResizeObserver(() => {
+      setViewportHeight(element.clientHeight);
+    });
+    observer.observe(element);
+    setViewportHeight(element.clientHeight);
+    return () => observer.disconnect();
+  }, [scrollRef]);
+
+  useLayoutEffect(() => {
+    const element = headerRef.current;
+    if (!element) {
+      setHeaderHeight(0);
+      return;
+    }
+
+    const observer = new ResizeObserver(() => {
+      setHeaderHeight(element.offsetHeight);
+    });
+    observer.observe(element);
+    setHeaderHeight(element.offsetHeight);
+    return () => observer.disconnect();
+  }, []);
+
+  useLayoutEffect(() => {
+    if (userCount > previousUserCount.current) {
+      followBottom.current = true;
+    }
+    previousUserCount.current = userCount;
+    if (followBottom.current) {
+      scrollToBottom();
+    }
+  }, [userCount, items.length, measureVersion]);
+
+  useEffect(
+    () => () => {
+      observers.current.forEach((observer) => observer.disconnect());
+      observers.current.clear();
+      if (measurementFrame.current !== null) {
+        cancelAnimationFrame(measurementFrame.current);
+        measurementFrame.current = null;
+      }
+    },
+    [],
+  );
+
+  const flushMeasurements = () => {
+    if (measurementFrame.current !== null) {
+      return;
+    }
+    measurementFrame.current = requestAnimationFrame(() => {
+      measurementFrame.current = null;
+      if (pendingMeasurements.current.size === 0) {
+        return;
+      }
+
+      let scrollAdjustment = 0;
+      const currentItems = itemsRef.current;
+      for (const [id, height] of pendingMeasurements.current) {
+        const previous = heights.current.get(id);
+        if (previous === height) {
+          continue;
+        }
+        const index = currentItems.findIndex(
+          (item) => item.message.id === id,
+        );
+        // A row above the viewport grew/shrank. Keep the visible content
+        // anchored instead of letting it jump, like react-virtuoso's size
+        // range system does.
+        if (
+          !followBottom.current &&
+          previous !== undefined &&
+          index >= 0 &&
+          index < startIndexRef.current
+        ) {
+          scrollAdjustment += height - previous;
+        }
+        heights.current.set(id, height);
+      }
+      pendingMeasurements.current.clear();
+
+      if (scrollAdjustment !== 0 && scrollRef.current) {
+        scrollRef.current.scrollTop += scrollAdjustment;
+        setScrollTop(scrollRef.current.scrollTop);
+      }
+      setMeasureVersion((version) => version + 1);
+    });
+  };
+
+  const getRowRef = (id: string) => {
+    let ref = rowRefs.current.get(id);
+    if (ref) {
+      return ref;
+    }
+
+    ref = (element: HTMLDivElement | null) => {
+      const previous = observers.current.get(id);
+      if (previous) {
+        previous.disconnect();
+        observers.current.delete(id);
+      }
+      if (!element) {
+        return;
+      }
+
+      const measure = () => {
+        const height = Math.ceil(element.getBoundingClientRect().height);
+        if (height > 0 && heights.current.get(id) !== height) {
+          pendingMeasurements.current.set(id, height);
+          flushMeasurements();
+        }
+      };
+
+      measure();
+      const observer = new ResizeObserver(measure);
+      observer.observe(element);
+      observers.current.set(id, observer);
+    };
+    rowRefs.current.set(id, ref);
+    return ref;
+  };
+
+  return (
+    <>
+      <div ref={headerRef}>{header}</div>
+      <div style={{ height: totalHeight, position: "relative" }}>
+        {items.slice(startIndex, endIndex).map((item, visibleIndex) => {
+          const index = startIndex + visibleIndex;
+          return (
+            <div
+              key={item.message.id}
+              ref={getRowRef(item.message.id)}
+              style={{
+                position: "absolute",
+                top: offsets[index],
+                left: 0,
+                right: 0,
+                minHeight: heights.current.has(item.message.id)
+                  ? undefined
+                  : estimateHeight(item),
+              }}
+            >
+              {renderItem(item, index)}
+            </div>
+          );
+        })}
+      </div>
+      {footer}
+    </>
+  );
+}
