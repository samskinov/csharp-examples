+/**
+ * Change the workspace and propagate it to everything that caches the
+ * previous directory: session metadata, file search and hooks. Tools always
+ * read process.cwd(), so process.chdir() is the source of truth.
+ */
+export async function applyWorkspaceChange(input: string): Promise<{
+  success: boolean;
+  path?: string;
+  message: string;
+}> {
+  const result = changeWorkspace(input);
+  if (!result.success || !result.path) {
+    return result;
+  }
+
+  updateSessionWorkspaceDirectory(result.path);
+
+  // Dynamic import avoids a module cycle: services/index -> tools ->
+  // changeDirectory -> workspace -> services/index.
+  try {
+    const { services } = await import("../services/index.js");
+    try {
+      await services.fileIndex?.refreshIndex(true);
+    } catch {
+      // File indexing is best-effort; the cwd itself already changed.
+    }
+    try {
+      await services.hooks?.initialize?.(result.path);
+    } catch {
+      // Hooks are optional and may not be initialized in every mode.
+    }
+  } catch {
+    // Services may not be initialized yet (early startup).
+  }
+
+  return result;
+}
