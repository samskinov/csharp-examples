+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+import { changeWorkspace, resolveWorkspacePath } from "./workspace.js";
+
+const originalCwd = process.cwd();
+const tempDirs: string[] = [];
+
+afterEach(() => {
+  process.chdir(originalCwd);
+  for (const dir of tempDirs.splice(0)) {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+describe("changeWorkspace", () => {
+  it("changes process.cwd so every tool sees the new directory", () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cn-cd-"));
+    tempDirs.push(dir);
+
+    const result = changeWorkspace(dir);
+
+    expect(result.success).toBe(true);
+    expect(fs.realpathSync(process.cwd())).toBe(fs.realpathSync(dir));
+  });
+
+  it("rejects a missing directory without changing cwd", () => {
+    const before = process.cwd();
+    const result = changeWorkspace("/definitely/not/a/real/directory");
+    expect(result.success).toBe(false);
+    expect(process.cwd()).toBe(before);
+  });
+
+  it("strips quotes and expands a leading tilde", () => {
+    expect(resolveWorkspacePath('"~/project"')).toBe(
+      path.resolve(os.homedir(), "project"),
+    );
+  });
+});
