@@ -0,0 +1,42 @@
+import { modelSupportsNativeTools } from "core/llm/toolSupport";
+
+import { selectSelectedChatModel } from "../slices/configSlice";
+import type { RootState } from "../store";
+
+export type ToolDeclarationMode = "native" | "text";
+
+/**
+ * Single source of truth for native vs text tool declarations.
+ *
+ * Custom OpenAI-compatible endpoints and local Ollama servers default to the
+ * text protocol because native function calling is unreliable there. The
+ * explicit experimental setting still wins. Keeping this decision in one
+ * helper ensures the prompt, the request and the error reminders all use the
+ * same syntax.
+ */
+export function getToolDeclarationMode(state: RootState): ToolDeclarationMode {
+  const model = selectSelectedChatModel(state);
+  if (!model) {
+    return "text";
+  }
+
+  const forced = state.config.config.experimental?.onlyUseSystemMessageTools;
+  if (forced === true) {
+    return "text";
+  }
+  if (forced === false) {
+    return "native";
+  }
+
+  const isCustomOpenAICompatible =
+    model.provider === "openai" &&
+    (!!model.onPremProxyUrl ||
+      (!!model.apiBase && !model.apiBase.includes("api.openai.com")));
+  const isLocalProvider = model.provider === "ollama";
+
+  return isCustomOpenAICompatible || isLocalProvider
+    ? "text"
+    : modelSupportsNativeTools(model)
+      ? "native"
+      : "text";
+}
