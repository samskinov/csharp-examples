@@ -0,0 +1,67 @@
+import * as fs from "fs";
+import * as os from "os";
+import path from "path";
+
+import { afterEach, describe, expect, it } from "vitest";
+
+import {
+  isTextVisibleForEdit,
+  markFileAsRead,
+  markFileRangeAsRead,
+  readFilesSet,
+  readFileRanges,
+} from "./readFile.js";
+
+const tempFiles: string[] = [];
+
+function makeFile(content: string): string {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "cn-read-"));
+  const file = path.join(dir, "file.txt");
+  fs.writeFileSync(file, content, "utf8");
+  tempFiles.push(dir);
+  return file;
+}
+
+afterEach(() => {
+  readFilesSet.clear();
+  readFileRanges.clear();
+  for (const dir of tempFiles.splice(0)) {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+describe("isTextVisibleForEdit", () => {
+  it("requires the file to have been read first", () => {
+    const file = makeFile("alpha\nbeta");
+    expect(isTextVisibleForEdit(file, "alpha")).toBe(false);
+
+    markFileAsRead(file);
+    expect(isTextVisibleForEdit(file, "alpha")).toBe(true);
+  });
+
+  it("accepts text covered by a read range only", () => {
+    const file = makeFile("alpha\nbeta");
+    markFileRangeAsRead(file, 1, 1, "alpha");
+
+    expect(isTextVisibleForEdit(file, "alpha")).toBe(true);
+    expect(isTextVisibleForEdit(file, "beta")).toBe(false);
+  });
+
+  it("rejects stale text after the file changed", () => {
+    const file = makeFile("alpha\nbeta");
+    markFileAsRead(file);
+
+    fs.writeFileSync(file, "gamma\ndelta", "utf8");
+
+    expect(isTextVisibleForEdit(file, "alpha")).toBe(false);
+    expect(isTextVisibleForEdit(file, "gamma")).toBe(true);
+  });
+
+  it("returns false when the file disappeared", () => {
+    const file = makeFile("alpha");
+    markFileAsRead(file);
+    fs.rmSync(file);
+
+    expect(isTextVisibleForEdit(file, "alpha")).toBe(false);
+  });
+});
