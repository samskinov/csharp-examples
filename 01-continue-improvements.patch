From ec0a0bd02b16317c568a0bfe8c2c0ef4bd8e6354 Mon Sep 17 00:00:00 2001
From: sam <sam@local>
Date: Tue, 17 Nov 2026 21:34:30 +0100
Subject: [PATCH 14/14] fix(llm): resolve tokenizer worker file in both jest
 and vitest

The test-only worker path assumed __dirname is the project root (jest
with cross-env), which broke vitest runs once compileChatMessages started
using the worker pool: the OpenAI stream tests failed with "Cannot find
module .../core/llm/llm/llamaTokenizerWorkerPool.mjs". Resolve the
directory that actually contains the worker file first, falling back to
the historical root+llm path.
---
 core/llm/asyncEncoder.ts | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/core/llm/asyncEncoder.ts b/core/llm/asyncEncoder.ts
index fab2e5a3c..4a7cd198e 100644
--- a/core/llm/asyncEncoder.ts
+++ b/core/llm/asyncEncoder.ts
@@ -1,3 +1,4 @@
+import * as fs from "fs";
 import path from "path";
 
 import workerpool from "workerpool";
@@ -56,9 +57,13 @@ export class GPTAsyncEncoder implements AsyncEncoder {
 }
 
 function workerCodeFilePath(workerFileName: string): string {
-  if (process.env.NODE_ENV === "test") {
-    // `cross-env` seems to make it so __dirname is the root of the project and not the directory containing this file
-    return path.join(__dirname, "llm", workerFileName);
+  // Under jest, cross-env used to make __dirname the project root instead of
+  // the directory containing this file, hence the historical "llm"
+  // subpath workaround. Prefer the directory that actually contains the
+  // worker file, so both jest (root) and vitest (real directory) resolve it.
+  const candidate = path.join(__dirname, workerFileName);
+  if (fs.existsSync(candidate)) {
+    return candidate;
   }
-  return path.join(__dirname, workerFileName);
+  return path.join(__dirname, "llm", workerFileName);
 }
-- 
