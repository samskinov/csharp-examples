+/**
+ * Worker-based counterpart of countToolsTokens: identical logic, but the
+ * tokenization of tool names, descriptions and schemas runs in the tokenizer
+ * worker pool instead of blocking the extension host main thread.
+ */
+async function countToolsTokensAsync(
+  tools: Tool[],
+  modelName: string,
+): Promise<number> {
+  let numTokens = 12;
+
+  const toolTokenCounts = await Promise.all(
+    tools.map(async (tool) => {
+      let functionTokens = await countTokensAsync(
+        tool.function.name,
+        modelName,
+      );
+      if (tool.function.description) {
+        functionTokens += await countTokensAsync(
+          tool.function.description,
+          modelName,
+        );
+      }
+      const props = tool.function.parameters?.properties;
+      if (props) {
+        for (const key in props) {
+          functionTokens += await countTokensAsync(key, modelName);
+          const fields = props[key];
+          if (fields) {
+            const fieldType = fields["type"];
+            const fieldDesc = fields["description"];
+            const fieldEnum = fields["enum"];
+            if (fieldType && typeof fieldType === "string") {
+              functionTokens += 2;
+              functionTokens += await countTokensAsync(fieldType, modelName);
+            }
+            if (fieldDesc && typeof fieldDesc === "string") {
+              functionTokens += 2;
+              functionTokens += await countTokensAsync(fieldDesc, modelName);
+            }
+            if (fieldEnum && Array.isArray(fieldEnum)) {
+              functionTokens -= 3;
+              for (const e of fieldEnum) {
+                functionTokens += 3;
+                functionTokens +=
+                  typeof e === "string"
+                    ? await countTokensAsync(e, modelName)
+                    : 5;
+              }
+            }
+          }
+        }
+      }
+      return functionTokens;
+    }),
+  );
