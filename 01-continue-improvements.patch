From 02c12ecab1f777fc31b36c930fec8f55b2d792af Mon Sep 17 00:00:00 2001
From: sam <sam@local>
Date: Tue, 17 Nov 2026 20:21:00 +0100
Subject: [PATCH 01/14] fix(llm): check response.ok and attach HTTP status to
 OpenAI-compatible stream errors

- _streamChat/_streamResponses/_responses/_streamFim now verify the HTTP
  status before consuming the stream; a 429 (or any non-200) surfaces as a
  descriptive error carrying .status instead of a malformed-JSON crash or a
  silently empty stream
- non-streaming path also detects {error: ...} bodies returned with 200
- 499 (user abort) keeps its silent-return behavior everywhere
---
 core/llm/llms/OpenAI.ts | 48 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/core/llm/llms/OpenAI.ts b/core/llm/llms/OpenAI.ts
index c65b55dc1..1b1546041 100644
--- a/core/llm/llms/OpenAI.ts
+++ b/core/llm/llms/OpenAI.ts
@@ -512,6 +512,30 @@ class OpenAI extends BaseLLM {
     }
   }
 
+  /**
+   * Throw a descriptive error carrying the HTTP status when the response is
+   * not OK, so callers (and the GUI retry policy) can identify rate limits
+   * and other HTTP failures on OpenAI-compatible endpoints.
+   */
+  private async _throwForResponseError(response: Response, endpoint: string) {
+    if (response.ok || response.status === 499) {
+      return;
+    }
+    let bodyText = "";
+    try {
+      bodyText = await response.text();
+    } catch {
+      // Ignore - the body may already be consumed or unreadable
+    }
+    const truncated =
+      bodyText.length > 1000 ? `${bodyText.slice(0, 1000)}…` : bodyText;
+    const error = new Error(
+      `HTTP ${response.status} ${response.statusText || ""} from ${endpoint}${truncated ? `: ${truncated}` : ""}`.trim(),
+    );
+    (error as any).status = response.status;
+    throw error;
+  }
+
   protected async *_streamChat(
     messages: ChatMessage[],
     signal: AbortSignal,
@@ -554,11 +578,24 @@ class OpenAI extends BaseLLM {
       if (response.status === 499) {
         return; // Aborted by user
       }
+      await this._throwForResponseError(response, "chat/completions");
       const data = await response.json();
+      if (data?.error) {
+        const errorDetail =
+          typeof data.error?.message === "string"
+            ? data.error.message
+            : JSON.stringify(data.error);
+        throw new Error(`Error response from chat/completions: ${errorDetail}`);
+      }
       yield data.choices[0].message;
       return;
     }
 
+    if (response.status === 499) {
+      return; // Aborted by user
+    }
+    await this._throwForResponseError(response, "chat/completions");
+
     for await (const value of streamSse(response)) {
       const chunk = fromChatCompletionChunk(value);
       if (chunk) {
@@ -603,6 +640,11 @@ class OpenAI extends BaseLLM {
       signal,
     });
 
+    if (response.status === 499) {
+      return; // Aborted by user
+    }
+    await this._throwForResponseError(response, "responses");
+
     for await (const evt of streamSse(response)) {
       try {
         const msg = fromResponsesChunk(evt);
@@ -646,6 +688,8 @@ class OpenAI extends BaseLLM {
       return { role: "assistant", content: "" };
     }
 
+    await this._throwForResponseError(response as Response, "responses");
+
     const data: any = await response.json().catch(() => ({}));
     const msg = fromResponsesChunk(data);
     if (msg) return msg;
@@ -682,6 +726,10 @@ class OpenAI extends BaseLLM {
       },
       signal,
     });
+    if (resp.status === 499) {
+      return; // Aborted by user
+    }
+    await this._throwForResponseError(resp, "fim/completions");
     for await (const chunk of streamSse(resp)) {
