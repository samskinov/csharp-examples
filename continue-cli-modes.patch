+/**
+ * Mid-stream resilience for the CLI chat stream (modeled on Gemini CLI's
+ * mid-stream retries):
+ *
+ * - per-chunk idle watchdog (a stalled/overloaded server is retried instead
+ *   of hanging forever)
+ * - retryable mid-stream failures (429, 5xx, dropped connections, idle
+ *   timeout) are retried up to 3 times with 1s/2s/4s backoff
+ * - continuation: with a partial answer the retry uses assistant prefill
+ *   (the model continues where it stopped, without regenerating); a
+ *   thinking-only or empty response is retried with an explicit
+ *   "provide your final answer" nudge
+ */
+
+import type { ModelConfig } from "@continuedev/config-yaml";
+import { BaseLlmApi } from "@continuedev/openai-adapters";
+import type {
+  ChatCompletionMessageParam,
+  ChatCompletionTool,
+} from "openai/resources.mjs";
+
+import { ToolMode } from "../permissions/types.js";
+import { telemetryService } from "../telemetry/telemetryService.js";
+import { ToolCall } from "../tools/index.js";
+import {
+  calculateMidStreamDelayMs,
+  chatCompletionStreamWithBackoff,
+  isMidStreamRetryableError,
+} from "../util/exponentialBackoff.js";
+import { logger } from "../util/logger.js";
+
+import {
+  processChunkContent,
+  processToolCallDelta,
+  recordStreamTelemetry,
+  trackFirstTokenTime,
+} from "./streamChatResponse.helpers.js";
+import {
+  getDefaultCompletionOptions,
+  type StreamCallbacks,
+} from "./streamChatResponse.types.js";
+
+interface ProcessChunkOptions {
+  chunk: any;
+  aiResponse: string;
+  toolCallsMap: Map<string, ToolCall>;
+  indexToIdMap: Map<number, string>;
+  callbacks?: StreamCallbacks;
+  isHeadless?: boolean;
+}
+
+/** Processes one streaming chunk: content accumulation + native tool deltas. */
+function processChunk(options: ProcessChunkOptions): {
+  aiResponse: string;
+  shouldContinue: boolean;
+} {
+  const {
+    chunk,
+    aiResponse,
+    toolCallsMap,
+    indexToIdMap,
+    callbacks,
+    isHeadless,
+  } = options;
+  // Safety check: ensure chunk has the expected structure
+  if (!chunk.choices || !chunk.choices[0]) {
+    return { aiResponse, shouldContinue: true };
+  }
+
+  const choice = chunk.choices[0];
+  if (!choice.delta) {
+    return { aiResponse, shouldContinue: true };
+  }
+
+  let updatedResponse = aiResponse;
+
+  // Handle content streaming
+  if (choice.delta.content) {
+    updatedResponse = processChunkContent(
+      choice.delta.content,
+      aiResponse,
+      callbacks,
+      isHeadless,
+    );
+  }
+
+  // Handle tool calls
+  if (choice.delta.tool_calls) {
+    for (const toolCallDelta of choice.delta.tool_calls) {
+      processToolCallDelta(toolCallDelta, toolCallsMap, indexToIdMap);
+    }
+  }
+
+  return { aiResponse: updatedResponse, shouldContinue: true };
+}
+
+const MAX_MID_STREAM_RETRIES = 3;
+
+/**
+ * A stream that completed without any answer content (reasoning only, or
+ * nothing at all). Retried with a nudge instead of returning silence.
+ */
+export class EmptyStreamError extends Error {
+  constructor(
+    message: string,
+    public readonly thinkingOnly: boolean,
+  ) {
+    super(message);
+    this.name = "EmptyStreamError";
+  }
+}
+
+export interface ResilientStreamParams {
+  llmApi: BaseLlmApi;
+  model: ModelConfig;
+  abortController: AbortController;
+  callbacks?: StreamCallbacks;
+  isHeadless?: boolean;
+  tools?: ChatCompletionTool[];
+  toolMode: ToolMode;
+  baseMessages: ChatCompletionMessageParam[];
+  requestStartTime: number;
+  /** Override for tests (defaults to the 1s/2s/4s exponential backoff). */
+  retryDelayMs?: number;
+}
+
+export interface ResilientStreamResult {
+  aiResponse: string;
+  toolCalls: ToolCall[];
+  usage: any;
+  /** True when the user aborted: the caller returns the partial content. */
+  aborted: boolean;
+}
+
+/**
+ * Builds the request messages for one attempt. On retries:
+ * - partial answer exists -> assistant prefill (model continues where it
+ *   stopped, without regenerating)
+ * - thinking-only or empty -> explicit nudge (partial reasoning cannot be
+ *   replayed to OpenAI-compatible APIs anyway)
+ */
+export function buildAttemptMessages(
+  baseMessages: ChatCompletionMessageParam[],
+  attempt: number,
+  aiResponse: string,
+  sawThinking: boolean,
+): { messages: ChatCompletionMessageParam[]; resetDisplay: boolean } {
+  if (attempt === 0) {
+    return { messages: baseMessages, resetDisplay: false };
+  }
+
+  const thinkingOnly = sawThinking && !aiResponse.trim();
+  const nudge = thinkingOnly
+    ? "[System] The previous response was interrupted while reasoning and contained no final answer. Provide your final answer now, concisely."
+    : "[System] The previous response was interrupted mid-answer. Continue exactly where it stopped, without repeating what was already written.";
+
+  let messages: ChatCompletionMessageParam[];
+  if (aiResponse.trim() && attempt === 1) {
+    messages = [
+      ...baseMessages,
+      { role: "assistant", content: aiResponse } as ChatCompletionMessageParam,
+    ];
+  } else if (aiResponse.trim()) {
+    messages = [
+      ...baseMessages,
+      { role: "assistant", content: aiResponse } as ChatCompletionMessageParam,
+      { role: "user", content: nudge } as ChatCompletionMessageParam,
+    ];
+  } else {
+    messages = [
+      ...baseMessages,
+      { role: "user", content: nudge } as ChatCompletionMessageParam,
+    ];
+  }
+
+  // A thinking-only/empty attempt produced nothing displayable: tell the UI
+  // to clear the streaming area before the retry (the partial display of a
+  // prefill continuation stays valid).
+  return { messages, resetDisplay: !aiResponse.trim() };
+}
+
+function createWatchdogNext(
+  iterator: AsyncGenerator<any>,
+  idleTimeoutMs: number,
+): () => Promise<IteratorResult<any>> {
+  if (idleTimeoutMs <= 0) {
+    return () => iterator.next();
+  }
+  return () => {
+    let idleTimer: ReturnType<typeof setTimeout> | undefined;
+    return Promise.race([
+      iterator.next(),
+      new Promise<never>((_, reject) => {
+        idleTimer = setTimeout(
+          () =>
+            reject(
+              new Error(
+                `Stream idle: no data received from the model for ${idleTimeoutMs}ms`,
+              ),
+            ),
+          idleTimeoutMs,
+        );
+      }),
+    ]).finally(() => clearTimeout(idleTimer));
+  };
+}
+
+interface AttemptState {
+  aiResponse: string;
+  sawThinking: boolean;
+  inputTokens: number;
+  outputTokens: number;
+  fullUsage: any;
+  firstTokenTime: number | null;
+  aborted: boolean;
+}
+
+async function readAttemptChunks(
+  iterator: AsyncGenerator<any>,
+  state: AttemptState,
+  context: {
+    model: ModelConfig;
+    abortController: AbortController;
+    callbacks?: StreamCallbacks;
+    isHeadless?: boolean;
+    tools?: ChatCompletionTool[];
+    requestStartTime: number;
+  },
+  toolCallsMap: Map<string, ToolCall>,
+  indexToIdMap: Map<number, string>,
+): Promise<void> {
+  const nextWithWatchdog = createWatchdogNext(iterator, idleTimeoutMs());
+
+  let chunkCount = 0;
+  let chunkNext = await nextWithWatchdog();
+  while (!chunkNext.done) {
+    if (context.abortController?.signal.aborted) {
+      logger.debug("Stream aborted");
+      state.aborted = true;
+      break;
+    }
+    const chunk = chunkNext.value;
+    chunkCount++;
+
+    logger.debug("Received chunk", { chunkCount, chunk });
+
+    // Track reasoning-only streams (drives the thinking-only retry nudge)
+    if ((chunk as any)?.choices?.[0]?.delta?.reasoning_content) {
+      state.sawThinking = true;
+    }
+
+    // Track token usage if available
+    if (chunk.usage) {
+      state.inputTokens = chunk.usage.prompt_tokens || 0;
+      state.outputTokens = chunk.usage.completion_tokens || 0;
+      state.fullUsage = chunk.usage; // Capture full usage incl. cache details
+    }
+
+    // Track first token time
+    state.firstTokenTime = trackFirstTokenTime(
+      state.firstTokenTime,
+      chunk,
+      context.requestStartTime,
+      context.model,
+      context.tools,
+    );
+
+    const result = processChunk({
+      chunk,
+      aiResponse: state.aiResponse,
+      toolCallsMap,
+      indexToIdMap,
+      callbacks: context.callbacks,
+      isHeadless: context.isHeadless,
+    });
+    state.aiResponse = result.aiResponse;
+    if (!result.shouldContinue) break;
+
+    chunkNext = await nextWithWatchdog();
+  }
+}
+
+function idleTimeoutMs(): number {
+  return Number(process.env.CONTINUE_CLI_IDLE_TIMEOUT_MS ?? 120_000);
+}
+
+function shouldRetryMidStream(
+  error: any,
+  connectionPhase: boolean,
+  attempt: number,
+): boolean {
+  const retryable =
+    error instanceof EmptyStreamError || isMidStreamRetryableError(error);
+
+  // Pre-stream (connection phase) errors were already retried by
+  // chatCompletionStreamWithBackoff - never replay them here.
+  return retryable && !connectionPhase && attempt < MAX_MID_STREAM_RETRIES;
+}
+
+function finalizeStreamSuccess(
+  state: AttemptState,
+  toolCallsMap: Map<string, ToolCall>,
+  context: {
+    model: ModelConfig;
+    requestStartTime: number;
+    tools?: ChatCompletionTool[];
+  },
+): ResilientStreamResult {
+  const responseEndTime = Date.now();
+  const cost = recordStreamTelemetry({
+    requestStartTime: context.requestStartTime,
+    responseEndTime,
+    inputTokens: state.inputTokens,
+    outputTokens: state.outputTokens,
+    model: context.model,
+    tools: context.tools,
+    fullUsage: state.fullUsage,
+  });
+  const totalDuration = responseEndTime - context.requestStartTime;
+
+  // Enhance fullUsage with model and cost for saving to session
+  if (state.fullUsage) {
+    state.fullUsage.model = context.model.model;
+    state.fullUsage.cost_cents = Math.round(cost * 100); // Convert dollars to cents
+  }
+
+  logger.debug("Stream complete", {
+    responseLength: state.aiResponse.length,
+    toolCallsCount: toolCallsMap.size,
+    inputTokens: state.inputTokens,
+    outputTokens: state.outputTokens,
+    cacheReadTokens: state.fullUsage?.prompt_tokens_details?.cache_read_tokens,
+    cacheWriteTokens:
+      state.fullUsage?.prompt_tokens_details?.cache_write_tokens,
+    cost,
+    duration: totalDuration,
+  });
+
+  const validToolCalls = Array.from(toolCallsMap.values()).filter(
+    (tc) => !!tc.name,
+  );
+  if (validToolCalls.length !== toolCallsMap.size) {
+    logger.error("Dropping incomplete tool call(s) from stream", {
+      total: toolCallsMap.size,
+      valid: validToolCalls.length,
+    });
+  }
+
+  return {
+    aiResponse: state.aiResponse,
+    toolCalls: validToolCalls,
+    usage: state.fullUsage,
+    aborted: false,
+  };
+}
+
+export async function consumeStreamWithResilience(
+  params: ResilientStreamParams,
+): Promise<ResilientStreamResult> {
+  const {
+    llmApi,
+    model,
+    abortController,
+    callbacks,
+    isHeadless,
+    tools,
+    toolMode,
+    baseMessages,
+    requestStartTime,
+  } = params;
+
+  const toolCallsMap = new Map<string, ToolCall>();
+  const indexToIdMap = new Map<number, string>();
+
+  // Accumulated state persists ACROSS attempts: the partial answer must
+  // survive a thrown stream so the retry can prefill-continue from it.
+  const state: AttemptState = {
+    aiResponse: "",
+    sawThinking: false,
+    inputTokens: 0,
+    outputTokens: 0,
+    fullUsage: null,
+    firstTokenTime: null,
+    aborted: false,
+  };
+
+  let attempt = 0;
+
+  while (true) {
+    let connectionPhase = false;
+    try {
+      const { messages: attemptMessages, resetDisplay } = buildAttemptMessages(
+        baseMessages,
+        attempt,
+        state.aiResponse,
+        state.sawThinking,
+      );
+      if (resetDisplay) {
+        callbacks?.onStreamReset?.();
+      }
+      state.sawThinking = false;
+
+      connectionPhase = true;
+      const stream = await chatCompletionStreamWithBackoff(
+        llmApi,
+        {
+          model: model.model,
+          messages: attemptMessages,
+          stream: true,
+          // In text tool mode the tools are described in the system message and
+          // parsed from the reply - the native tools parameter must stay empty
+          // so that strict OpenAI-compatible servers never see it.
+          tools: toolMode === "text" ? undefined : tools,
+          ...getDefaultCompletionOptions(model.defaultCompletionOptions),
+        },
+        abortController.signal,
+      );
+      connectionPhase = false;
+
+      await readAttemptChunks(
+        stream[Symbol.asyncIterator](),
+        state,
+        {
+          model,
+          abortController,
+          callbacks,
+          isHeadless,
+          tools,
+          requestStartTime,
+        },
+        toolCallsMap,
+        indexToIdMap,
+      );
+
+      // Invalid-stream detection (Gemini CLI pattern): a stream that ended
+      // with reasoning only - or nothing at all - is retried with a nudge;
+      // once the retry budget is exhausted the error surfaces instead of
+      // returning silence to the user.
+      const noAnswer = !state.aiResponse.trim() && toolCallsMap.size === 0;
+      if (noAnswer && !state.aborted) {
+        throw new EmptyStreamError(
+          state.sawThinking
+            ? "Stream ended with reasoning only and no final answer"
+            : "Stream ended with an empty response",
+          state.sawThinking,
+        );
+      }
+
+      return finalizeStreamSuccess(state, toolCallsMap, {
+        model,
+        requestStartTime,
+        tools,
+      });
+    } catch (error: any) {
+      const errorDuration = Date.now() - requestStartTime;
+
+      // Log failed API request
+      telemetryService.logApiRequest({
+        model: model.model,
+        durationMs: errorDuration,
+        success: false,
+        error: error.message || String(error),
+      });
+
+      if (error.name === "AbortError" || abortController?.signal.aborted) {
+        logger.debug("Stream aborted by user");
+        state.aborted = true;
+        return {
+          aiResponse: state.aiResponse,
+          toolCalls: [],
+          usage: state.fullUsage,
+          aborted: true,
+        };
+      }
+
+      if (!shouldRetryMidStream(error, connectionPhase, attempt)) {
+        throw error;
+      }
+
+      attempt++;
+      const delayMs =
+        params.retryDelayMs ?? calculateMidStreamDelayMs(attempt - 1);
+      logger.info(
+        `Stream interrupted (${error.message}) - retrying attempt ${attempt}/${MAX_MID_STREAM_RETRIES} in ${delayMs}ms`,
+      );
+      callbacks?.onSystemMessage?.(
+        `⟳ ${error.message} - retrying (attempt ${attempt}/${MAX_MID_STREAM_RETRIES})…`,
+      );
+
+      // Per-attempt state: partial native tool calls are discarded (incomplete
+      // arguments); accumulated content is kept for prefill continuation.
+      toolCallsMap.clear();
+      indexToIdMap.clear();
+      state.firstTokenTime = null;
+
+      await new Promise((resolve) => setTimeout(resolve, delayMs));
+    }
+  }
+}
