+
+    expect(result.aborted).toBe(false);
+    expect(result.aiResponse).toBe("Hello world!");
+    expect(result.toolCalls).toHaveLength(0);
+
+    // The retry must use assistant prefill: the partial answer is sent back
+    // so the model continues instead of regenerating (and thinking again)
+    expect(calls.length).toBe(2);
+    const retryMessages = calls[1].messages;
+    const lastMessage = retryMessages[retryMessages.length - 1];
+    expect(lastMessage.role).toBe("assistant");
+    expect(lastMessage.content).toBe("Hello ");
+  });
+
+  it("retries a thinking-only stream with a final-answer nudge", async () => {
+    const calls: any[] = [];
+    const llmApi = {
+      chatCompletionStream: vi.fn((params: any) => {
+        calls.push(params);
+        if (calls.length === 1) {
+          // First attempt: reasoning only, no answer, stream ends cleanly
+          return streamOf([
+            {
+              choices: [
