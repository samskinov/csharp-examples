+                  delta: { reasoning_content: "deep thoughts..." },
+                  finish_reason: null,
+                },
+              ],
+            },
+            { choices: [{ delta: {}, finish_reason: "stop" }] },
+          ]) as any;
+        }
+        return streamOf([contentChunk("Final answer", "stop")]) as any;
+      }),
+    };
+
+    const result = await consumeStreamWithResilience(makeParams(llmApi));
+
+    expect(result.aiResponse).toBe("Final answer");
+    expect(calls.length).toBe(2);
+
+    // Thinking-only retries reset the content and append a nudge so the
+    // model converges to a final answer instead of returning silence
+    const retryMessages = calls[1].messages;
+    const lastMessage = retryMessages[retryMessages.length - 1];
+    expect(lastMessage.role).toBe("user");
+    expect(JSON.stringify(lastMessage.content)).toContain("final answer");
+  });
+
+  it("gives up after the maximum number of mid-stream retries", async () => {
+    const llmApi = {
+      chatCompletionStream: vi.fn(() => {
+        const generator = (async function* () {
+          const error = new Error("HTTP 429 Too Many Requests");
+          (error as any).status = 429;
+          throw error;
+        })();
+        return generator as any;
+      }),
+    };
+
+    await expect(
+      consumeStreamWithResilience(makeParams(llmApi)),
+    ).rejects.toThrow();
+
+    // 1 initial attempt + 3 mid-stream retries
+    expect(llmApi.chatCompletionStream).toHaveBeenCalledTimes(4);
+  });
+
+  it("does not retry connection-phase failures twice", async () => {
+    const llmApi = {
+      chatCompletionStream: vi.fn(() => {
+        // A non-retryable status thrown before the stream starts: retried
+        // neither by the backoff helper nor by the mid-stream loop
+        const error = new Error("HTTP 400 Bad Request");
+        (error as any).status = 400;
+        throw error;
+      }),
+    };
+
+    await expect(
+      consumeStreamWithResilience(makeParams(llmApi)),
+    ).rejects.toThrow("HTTP 400 Bad Request");
+
+    expect(llmApi.chatCompletionStream).toHaveBeenCalledTimes(1);
+  });
+});
