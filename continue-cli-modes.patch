+/**
+ * Text tool mode: tools are described in the system message and tool calls
+ * are parsed from fenced code blocks in the model's reply, instead of using
+ * the OpenAI-style `tools` parameter (native function calling).
+ *
+ * This is the escape hatch for OpenAI-compatible servers whose function
+ * calling is unreliable (LM Studio, llama.cpp, small local models, proxies).
+ */
+
+import { Tool, ToolCall } from "./types.js";
+
+export const TEXT_TOOL_FENCE = "tool";
+
+/**
+ * Minimal shape needed to describe a tool in the system message. Accepts
+ * both the internal Tool shape and the ChatCompletionTool shape.
+ */
+export interface TextToolDescription {
+  name: string;
+  description: string;
+  parameters: any;
+}
+
+export function chatCompletionToolToDescription(
+  tool: ChatCompletionToolLike,
+): TextToolDescription {
+  return {
+    name: tool.function?.name ?? "",
+    description: tool.function?.description ?? "",
+    parameters: tool.function?.parameters ?? {},
+  };
+}
+
+export interface ChatCompletionToolLike {
+  function?: {
+    name?: string;
+    description?: string;
+    parameters?: any;
+  };
+}
+
+/**
+ * Builds the system message section that describes how to call tools in
+ * text mode. Mirrors the semantics of the GUI's system-message tools
+ * framework (one fenced block per call, sequential execution).
+ */
+export function buildTextToolsInstructions(
+  tools: TextToolDescription[],
+): string {
+  if (tools.length === 0) {
+    return "";
+  }
+
+  const toolDocs = tools
+    .map((tool) => {
+      const params = tool.parameters?.properties
+        ? Object.entries(tool.parameters.properties)
+            .map(
+              ([key, schema]: [string, any]) =>
+                `- ${key}${schema?.type ? ` (${schema.type})` : ""}${schema?.description ? `: ${schema.description}` : ""}`,
+            )
+            .join("\n")
+        : "- (no parameters)";
+      const required = tool.parameters?.required?.length
+        ? `\n  Required: ${tool.parameters.required.join(", ")}`
+        : "";
+      return `- **${tool.name}**: ${tool.description}\n  Parameters:\n${params}${required}`;
+    })
+    .join("\n\n");
+
+  const example = JSON.stringify({
+    name: tools[0].name,
+    arguments: {},
+  });
+
+  return `
+
+<context name="toolCalling">
+# Tool calling
+
+Native tool calling is disabled for this session. You call tools by writing
+ONE fenced code block per tool call, with the language identifier "${TEXT_TOOL_FENCE}",
+and a single JSON object as the body:
+
+\`\`\`${TEXT_TOOL_FENCE}
+${example}
+\`\`\`
+
+Rules:
+- Exactly one JSON object per code block, with "name" (string) and "arguments" (object).
+- Multiple tool calls: write several code blocks; they run in the order written.
+- Do not wrap tool calls in any other text structure; do not put them inside other code blocks.
+- After each call you will receive the result and can continue.
+- If you do not need a tool, simply answer normally without any "${TEXT_TOOL_FENCE}" block.
+
+Available tools:
+
+${toolDocs}
+</context>
+`;
+}
+
+/**
+ * Extracts tool calls from a completed reply written in text tool mode.
+ * Recognizes fences of the form ```tool ... ``` (and tolerates ```json ...
+ * ``` when the body parses to a {name, arguments} object whose name is a
+ * known tool). Unknown names and non-JSON blocks are left alone.
+ */
+export function extractToolCallsFromText(
+  content: string,
+  allowedToolNames: Set<string>,
+): { toolCalls: ToolCall[]; hasToolCalls: boolean } {
+  const toolCalls: ToolCall[] = [];
+  const fenceRegex = /```([^\n`]*)\n([\s\S]*?)```/g;
+
+  let match: RegExpExecArray | null;
+  while ((match = fenceRegex.exec(content)) !== null) {
+    const info = (match[1] ?? "").trim().toLowerCase();
+    const body = (match[2] ?? "").trim();
+    if (info !== TEXT_TOOL_FENCE && info !== "json") {
+      continue;
+    }
+
+    let parsed: any;
+    try {
+      parsed = JSON.parse(body);
+    } catch {
+      continue;
+    }
+
+    const name =
+      typeof parsed?.name === "string" ? (parsed.name as string) : undefined;
+    if (!name || !allowedToolNames.has(name)) {
+      continue;
+    }
+
+    let args = parsed?.arguments;
+    if (typeof args === "string") {
+      try {
+        args = JSON.parse(args);
+      } catch {
+        args = {};
+      }
+    }
+    if (args === null || args === undefined) {
+      args = {};
+    }
+    if (typeof args !== "object" || Array.isArray(args)) {
+      continue;
+    }
+
+    toolCalls.push({
+      id: `text_tool_call_${toolCalls.length}`,
+      name,
+      arguments: args,
+      argumentsStr: JSON.stringify(args),
+      startNotified: false,
+    });
+  }
+
+  return { toolCalls, hasToolCalls: toolCalls.length > 0 };
+}
