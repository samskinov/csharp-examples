 }
 
+/**
+ * Whether an error raised DURING stream consumption is worth a mid-stream
+ * retry: the standard retryable errors plus stalled/dropped streams.
+ */
+export function isMidStreamRetryableError(error: any): boolean {
+  if (isRetryableError(error)) {
+    return true;
+  }
+  const message = (error?.message ?? "").toLowerCase();
+  return (
+    message.includes("stream idle") ||
+    message.includes("premature close") ||
+    message.includes("socket hang up") ||
+    message.includes("econnreset")
+  );
+}
+
+/**
+ * Delay before a mid-stream retry attempt (1s, 2s, 4s — same shape as the
+ * GUI retry policy and Gemini CLI's mid-stream retries).
+ */
+export function calculateMidStreamDelayMs(attempt: number): number {
+  return Math.min(1000 * Math.pow(2, Math.max(0, attempt)), 8000);
+}
