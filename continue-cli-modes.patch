+          // First attempt: one token, then a mid-stream rate limit
+          return (async function* () {
+            yield contentChunk("Hello ");
+            const error = new Error("HTTP 429 Too Many Requests");
+            (error as any).status = 429;
+            throw error;
+          })() as any;
+        }
+        // Second attempt: the model continues from the partial
+        return streamOf([
+          contentChunk("world"),
+          contentChunk("!", "stop"),
+        ]) as any;
+      }),
+    };
+
