diff --git a/extensions/vscode/src/extension.ts b/extensions/vscode/src/extension.ts
index 4712ebc42..fff381be7 100644
--- a/extensions/vscode/src/extension.ts
+++ b/extensions/vscode/src/extension.ts
@@ -3,10 +3,80 @@
  */
 
 import { setupCa } from "core/util/ca";
+import fs from "fs";
+import os from "os";
+import path from "path";
 import * as vscode from "vscode";
 
 export { default as buildTimestamp } from "./.buildTimestamp";
 
+function formatActivationError(error: unknown): string {
+  if (error instanceof Error) {
+    return error.stack || error.message;
+  }
+  try {
+    return typeof error === "string" ? error : JSON.stringify(error, null, 2);
+  } catch {
+    return String(error);
+  }
+}
+
+/**
+ * Activation failures happen before most of the extension is registered (and
+ * before the continue.viewLogs command exists), so the old "View Logs" button
+ * did nothing. Write the real error to a file and to an output channel that
+ * the notification can open directly.
+ */
+function reportActivationError(error: unknown, channel: vscode.OutputChannel) {
+  const details = [
+    `Continue activation failed at ${new Date().toISOString()}`,
+    `VS Code ${vscode.version}`,
+    `Node ${process.version}`,
+    `Platform ${process.platform}-${process.arch}`,
+    `Extension ${path.dirname(__dirname)}`,
+    "",
+    formatActivationError(error),
+  ].join("\n");
+
+  console.error(details);
+  channel.appendLine(details);
+  channel.show(true);
+
+  try {
+    const logDir = path.join(os.homedir(), ".continue", "logs");
+    fs.mkdirSync(logDir, { recursive: true });
+    fs.writeFileSync(
+      path.join(logDir, "activation-error.log"),
+      `${details}\n`,
+      "utf8",
+    );
+  } catch {
+    // The output channel is still available if the filesystem is read-only.
+  }
+
+  const message =
+    error instanceof Error
+      ? error.message
+      : typeof error === "string"
+        ? error
+        : String(error);
+  const shortMessage = message.split("\n")[0].slice(0, 300);
+
+  void vscode.window
+    .showErrorMessage(
+      `Error activating the Continue extension: ${shortMessage}`,
+      "Show Details",
+      "Retry",
+    )
+    .then((selection) => {
+      if (selection === "Show Details") {
+        channel.show(true);
+      } else if (selection === "Retry") {
+        vscode.commands.executeCommand("workbench.action.reloadWindow");
+      }
+    });
+}
+
 async function dynamicImportAndActivate(context: vscode.ExtensionContext) {
   await setupCa();
   const { activateExtension } = await import("./activation/activate");
@@ -14,22 +84,13 @@ async function dynamicImportAndActivate(context: vscode.ExtensionContext) {
 }
 
 export function activate(context: vscode.ExtensionContext) {
+  const activationChannel = vscode.window.createOutputChannel(
+    "Continue Activation",
+  );
+  context.subscriptions.push(activationChannel);
+
   return dynamicImportAndActivate(context).catch((e) => {
-    console.log("Error activating extension: ", e);
-    vscode.window
-      .showWarningMessage(
-        "Error activating the Continue extension.",
-        "View Logs",
-        "Retry",
