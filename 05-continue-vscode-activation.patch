-        fs.unwatchFile(outFile);
-        process.exit(0);
-      }
-    });
-
-    console.log("Triggering VS Code Extension esbuild rebuild...");
-    writeBuildTimestamp();
+    const ctx = await esbuild.context(esbuildConfig);
+    await ctx.rebuild();
