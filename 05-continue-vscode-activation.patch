 extensions/vscode/scripts/esbuild.js    | 103 +++++++++++++++++++-----
 extensions/vscode/scripts/prepackage.js |  24 ++++++
 extensions/vscode/src/extension.ts      |  91 +++++++++++++++++----
 4 files changed, 187 insertions(+), 42 deletions(-)

