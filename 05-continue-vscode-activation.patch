diff --git a/extensions/vscode/scripts/prepackage.js b/extensions/vscode/scripts/prepackage.js
index 5066d9b79..18559d13f 100644
--- a/extensions/vscode/scripts/prepackage.js
+++ b/extensions/vscode/scripts/prepackage.js
@@ -262,6 +262,30 @@ void (async () => {
     console.log(`[info] Copied ${path.basename(f)}`);
   }
 
+  // win-ca native binding: esbuild cannot bundle the dynamic require
+  // ("./crypt32-" + arch), so the loader points at out/crypt32-<arch>.node.
+  if (isWinTarget) {
+    const winCaNative = path.join(
+      continueDir,
+      "core",
+      "node_modules",
+      "win-ca",
+      "lib",
+      `crypt32-${arch}.node`,
+    );
+    if (fs.existsSync(winCaNative)) {
+      fs.copyFileSync(
+        winCaNative,
+        path.join(__dirname, "..", "out", `crypt32-${arch}.node`),
+      );
+      console.log(`[info] Copied win-ca native binding for ${target}`);
+    } else {
