index 000000000..6d1939b66
--- /dev/null
+++ b/extensions/cli/src/util/workspace.ts
@@ -0,0 +1,121 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+const recentDirectories = new Set<string>();
+
+function expandTilde(input: string): string {
+  if (input === "~") {
+    return os.homedir();
+  }
+  if (input.startsWith("~/") || input.startsWith("~\\")) {
+    return path.join(os.homedir(), input.slice(2));
+  }
+  return input;
+}
+
+export function resolveWorkspacePath(input: string): string {
+  const trimmed = input.trim();
+  const stripped =
+    trimmed.length >= 2 &&
+    ((trimmed.startsWith('"') && trimmed.endsWith('"')) ||
+      (trimmed.startsWith("'") && trimmed.endsWith("'")))
+      ? trimmed.slice(1, -1)
+      : trimmed;
+  const expanded = expandTilde(stripped);
+  return path.resolve(expanded);
+}
+
+export function changeWorkspace(input: string): {
+  success: boolean;
+  path?: string;
+  message: string;
+} {
+  if (!input.trim()) {
+    return {
+      success: true,
+      path: process.cwd(),
+      message: `Workspace: ${process.cwd()}`,
+    };
+  }
+  let resolved: string;
+  try {
+    resolved = resolveWorkspacePath(input);
+  } catch (error) {
+    return {
+      success: false,
+      message: `Invalid workspace path: ${error instanceof Error ? error.message : String(error)}`,
+    };
+  }
+  if (!fs.existsSync(resolved)) {
+    return {
+      success: false,
+      message: `Workspace does not exist: ${resolved}`,
+    };
+  }
+  if (!fs.statSync(resolved).isDirectory()) {
+    return {
+      success: false,
+      message: `Not a directory: ${resolved}`,
+    };
+  }
+
+  process.chdir(resolved);
+  recentDirectories.delete(resolved);
+  recentDirectories.add(resolved);
+  return {
+    success: true,
+    path: resolved,
+    message: `Workspace: ${resolved}`,
+  };
+}
+
+export function getDirectorySuggestions(
+  input: string,
+  limit: number = 12,
+): string[] {
+  const trimmed = input.trim();
+  const expanded = expandTilde(trimmed);
+  if (!expanded) {
+    return Array.from(recentDirectories)
+      .reverse()
+      .filter((entry) => fs.existsSync(entry))
+      .slice(0, limit);
+  }
+
+  const absolute = path.resolve(expanded);
+  const endsWithSeparator =
+    expanded.endsWith("/") || expanded.endsWith("\\");
+  const base = endsWithSeparator ? absolute : path.dirname(absolute);
+  const prefix = endsWithSeparator ? "" : path.basename(absolute).toLowerCase();
+  if (!fs.existsSync(base) || !fs.statSync(base).isDirectory()) {
+    return [];
+  }
+
+  let entries: fs.Dirent[];
+  try {
+    entries = fs.readdirSync(base, { withFileTypes: true });
+  } catch {
+    return [];
+  }
+  const suggestions = entries
+    .filter(
+      (entry) =>
+        entry.isDirectory() &&
+        !entry.name.startsWith(".") &&
+        entry.name.toLowerCase().startsWith(prefix),
+    )
+    .sort((a, b) => a.name.localeCompare(b.name))
+    .map((entry) => path.join(base, entry.name));
+
+  for (const recent of Array.from(recentDirectories).reverse()) {
+    if (
+      fs.existsSync(recent) &&
+      recent.toLowerCase().startsWith(absolute.toLowerCase()) &&
+      !suggestions.includes(recent)
+    ) {
+      suggestions.unshift(recent);
+    }
+  }
+  return suggestions.slice(0, limit);
+}
