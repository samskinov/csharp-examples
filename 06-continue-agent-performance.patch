+import path from "path";
+import { glob } from "glob";
+
+import { Tool } from "./types.js";
+
+export const globFilesTool: Tool = {
+  name: "Glob",
+  displayName: "Glob",
+  description:
+    "Find files recursively using a glob pattern without depending on ripgrep.",
+  parameters: {
+    type: "object",
+    required: ["pattern"],
+    properties: {
+      pattern: {
+        type: "string",
+        description:
+          "Glob pattern such as '**/*.ts', 'src/**/*.cs' or '**/package.json'",
+      },
+      path: {
+        type: "string",
+        description: "Directory to search from (defaults to current directory)",
+      },
+      limit: {
+        type: "number",
+        description: "Maximum number of files (defaults to 100)",
+      },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  preprocess: async (args) => ({
+    args,
+    preview: [
+      {
+        type: "text",
+        content: `Will find files matching ${String(args.pattern ?? "")}`,
+      },
+    ],
+  }),
+  run: async (args: {
+    pattern: string;
+    path?: string;
+    limit?: number;
+  }): Promise<string> => {
+    const cwd = args.path ? path.resolve(args.path) : process.cwd();
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 100, 500)
+        : 100;
+    const matches = await glob(args.pattern, {
+      cwd,
+      absolute: false,
+      nodir: true,
+      dot: false,
+      ignore: [
+        "**/node_modules/**",
+        "**/.git/**",
+        "**/dist/**",
+        "**/build/**",
+        "**/coverage/**",
+      ],
+    });
+    const limited = matches.slice(0, limit);
+    const suffix =
+      matches.length > limit
+        ? `\n\n[Results truncated: ${limited.length} of ${matches.length} files]`
+        : "";
+    return limited.length > 0
+      ? `Files matching "${args.pattern}" in ${cwd}:\n${limited.join("\n")}${suffix}`
+      : `No files matching "${args.pattern}" found in ${cwd}.`;
+  },
+};
