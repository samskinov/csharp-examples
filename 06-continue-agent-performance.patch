+import { ToolImpl } from ".";
+import { getStringArg } from "../parseArgs";
+
+function quoteForShell(value: string): string {
+  if (!value.includes(" ") && !value.includes("\t")) {
+    return value;
+  }
+  return `"${value.replace(/"/g, '\\"')}"`;
+}
+
+async function resolveDotnetCommand(
+  extras: any,
+  cwd?: string,
+): Promise<string | undefined> {
+  try {
+    const [stdout, stderr] = await extras.ide.subprocess(
+      "dotnet --version",
+      cwd,
+    );
+    if ((stdout || "").trim()) {
+      return "dotnet";
+    }
+    if ((stderr || "").includes("dotnet")) {
+      return "dotnet";
+    }
+  } catch {}
+
+  try {
+    const [whereOut] = await extras.ide.subprocess("where.exe dotnet", cwd);
+    const candidate = (whereOut || "")
+      .split(/\r?\n/)
+      .map((line: string) => line.trim())
+      .find((line: string) => line.toLowerCase().endsWith("dotnet.exe"));
+    if (candidate) {
+      return quoteForShell(candidate);
+    }
+  } catch {}
+
+  try {
+    const [powershellOut] = await extras.ide.subprocess(
+      'powershell.exe -NoProfile -Command "& (Join-Path $env:ProgramFiles \"dotnet\\dotnet.exe\") --version"',
+      cwd,
+    );
+    if ((powershellOut || "").trim()) {
+      return quoteForShell(
+        `${process.env?.ProgramFiles ?? "C:\\Program Files"}\\dotnet\\dotnet.exe`,
+      );
+    }
+  } catch {}
+  return undefined;
+}
+
+async function runDotnet(
+  extras: any,
+  cwd: string | undefined,
+  args: string[],
+): Promise<any[]> {
+  const executable = await resolveDotnetCommand(extras, cwd);
+  if (!executable) {
+    return [
+      {
+        name: "Dotnet",
+        description: "dotnet executable resolution",
+        content:
+          "No dotnet executable found on PATH or in the standard Windows .NET location. Install the .NET SDK or add dotnet.exe to PATH.",
+      },
+    ];
+  }
+  const [stdout, stderr] = await extras.ide.subprocess(
+    `${executable} ${args.map(quoteForShell).join(" ")}`,
+    cwd,
+  );
+  return [
+    {
+      name: "Dotnet",
+      description: "dotnet command output",
+      content: [stdout.trim(), stderr.trim()].filter(Boolean).join("\n"),
+    },
+  ];
+}
+
+export const dotnetProjectsImpl: ToolImpl = async (args, extras) => {
+  const cwd = typeof args.path === "string" ? getStringArg(args, "path") : undefined;
+  const patterns = ["*.csproj", "*.sln", "*.slnx"];
+  const results: string[] = [];
+  for (const pattern of patterns) {
+    const matches = await extras.ide.getFileResults(pattern, 100);
+    results.push(...matches);
+  }
+  const unique = Array.from(new Set(results)).slice(0, 200);
+  return [
+    {
+      name: "Dotnet Projects",
+      description: "Solutions and projects",
+      content:
+        unique.length > 0
+          ? unique.join("\n")
+          : "No .NET solution or project files found.",
+    },
+  ];
+};
+
+export const dotnetBuildImpl: ToolImpl = async (args, extras) => {
+  const cwd = typeof args.path === "string" ? getStringArg(args, "path") : undefined;
+  const commandArgs = ["build"];
+  if (typeof args.path === "string") commandArgs.push(args.path);
+  if (typeof args.configuration === "string") {
+    commandArgs.push("-c", args.configuration);
+  }
+  if (args.noRestore === true) commandArgs.push("--no-restore");
+  commandArgs.push("--nologo", "-v:minimal");
+  return await runDotnet(extras, cwd ? undefined : undefined, commandArgs);
+};
+
+export const dotnetTestImpl: ToolImpl = async (args, extras) => {
+  const cwd = typeof args.path === "string" ? getStringArg(args, "path") : undefined;
+  const commandArgs = ["test"];
+  if (typeof args.path === "string") commandArgs.push(args.path);
+  if (typeof args.filter === "string") {
+    commandArgs.push("--filter", args.filter);
+  }
+  if (args.noBuild === true) commandArgs.push("--no-build");
+  commandArgs.push("--nologo");
+  return await runDotnet(extras, cwd ? undefined : undefined, commandArgs);
+};
+
+export const dotnetFormatCheckImpl: ToolImpl = async (args, extras) => {
+  const cwd = typeof args.path === "string" ? getStringArg(args, "path") : undefined;
+  const commandArgs = ["format"];
+  if (typeof args.path === "string") commandArgs.push(args.path);
+  commandArgs.push("--verify-no-changes");
+  if (args.noRestore === true) commandArgs.push("--no-restore");
+  return await runDotnet(extras, cwd ? undefined : undefined, commandArgs);
+};
