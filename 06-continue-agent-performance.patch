+    /\b(read|search|inspect|analyze|analyse|edit|modify|run|grep|glob|list|check|fetch|open)\w*\b/i;
+  return (
+    announcements.test(lower) ||
+    (actionWords.test(lower) && lower.length < 600)
+  );
+}
