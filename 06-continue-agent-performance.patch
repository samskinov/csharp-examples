diff --git a/extensions/cli/src/tools/applyPatch.ts b/extensions/cli/src/tools/applyPatch.ts
new file mode 100644
index 000000000..91797ff61
--- /dev/null
+++ b/extensions/cli/src/tools/applyPatch.ts
@@ -0,0 +1,212 @@
+import fs from "fs";
+import path from "path";
+
+import { applyUnifiedDiff } from "core/edit/lazy/unifiedDiffApply.js";
+
+import { Tool } from "./types.js";
+
+interface PatchFile {
+  filepath: string;
+  body: string[];
+  unified: boolean;
+}
+
+function parseBeginPatch(patch: string): PatchFile[] {
+  const files: PatchFile[] = [];
+  let current: PatchFile | undefined;
+  for (const line of patch.replace(/\r\n/g, "\n").split("\n")) {
+    if (line.startsWith("*** Begin Patch")) continue;
+    if (line.startsWith("*** End Patch")) break;
+    const update = line.match(/^\*\*\* (?:Update|Add) File:\s*(.+)$/);
+    if (update) {
+      current = { filepath: update[1].trim(), body: [], unified: false };
+      files.push(current);
+      continue;
+    }
+    if (line.startsWith("*** Delete File:")) continue;
+    if (line.startsWith("*** Move to:")) continue;
+    if (current) current.body.push(line);
+  }
+  return files;
+}
+
+function parseUnifiedPatch(patch: string): PatchFile[] {
+  const lines = patch.replace(/\r\n/g, "\n").split("\n");
+  const files: PatchFile[] = [];
+  let current: PatchFile | undefined;
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (line.startsWith("--- ")) {
+      const oldPath = line.slice(4).trim();
+      const next = lines[i + 1];
+      if (next?.startsWith("+++ ")) {
+        const newPath = next.slice(4).trim();
+        const filepath =
+          newPath === "/dev/null"
+            ? oldPath
+            : newPath.replace(/^a\/|^b\//, "");
+        current = { filepath, body: [], unified: true };
+        files.push(current);
+        i++;
+        continue;
+      }
+    }
+    if (current?.unified) current.body.push(line);
+  }
+  return files;
+}
+
+function applyCustomHunks(source: string, body: string[]): string {
+  let sourceLines = source.split(/\r?\n/);
+  const hunks: string[][] = [];
+  let hunk: string[] = [];
+  for (const line of body) {
+    if (/^@@/.test(line)) {
+      if (hunk.length > 0) hunks.push(hunk);
+      hunk = [];
+    } else {
+      hunk.push(line);
+    }
+  }
+  if (hunk.length > 0) hunks.push(hunk);
+
+  for (const lines of hunks) {
+    const oldLines: string[] = [];
+    const newLines: string[] = [];
+    for (const line of lines) {
+      if (line.startsWith("+") && !line.startsWith("+++")) {
+        newLines.push(line.slice(1));
+      } else if (line.startsWith("-") && !line.startsWith("---")) {
+        oldLines.push(line.slice(1));
+      } else if (line.startsWith(" ")) {
+        oldLines.push(line.slice(1));
+        newLines.push(line.slice(1));
+      } else if (line === "") {
+        oldLines.push("");
+        newLines.push("");
+      }
+    }
+    if (oldLines.length === 0) {
+      sourceLines = [...newLines, ...sourceLines];
+      continue;
+    }
+    let index = -1;
+    for (let i = 0; i <= sourceLines.length - oldLines.length; i++) {
+      if (
+        oldLines.every((oldLine, j) => sourceLines[i + j] === oldLine)
+      ) {
+        index = i;
+        break;
+      }
+    }
+    if (index < 0) {
+      for (let i = 0; i <= sourceLines.length - oldLines.length; i++) {
+        if (
+          oldLines.every(
+            (oldLine, j) =>
+              sourceLines[i + j]?.replace(/^\s+/, "") ===
+              oldLine.replace(/^\s+/, ""),
+          )
+        ) {
+          index = i;
+          break;
+        }
+      }
+    }
+    if (index < 0) {
+      throw new Error(
+        `Patch hunk could not be applied cleanly:\n${oldLines.join("\n")}`,
+      );
+    }
+    sourceLines.splice(index, oldLines.length, ...newLines);
+  }
+  return sourceLines.join("\n");
+}
+
+export const applyPatchTool: Tool = {
+  name: "ApplyPatch",
+  displayName: "Apply Patch",
+  description:
+    "Apply an atomic unified patch to one or more existing files.",
+  parameters: {
+    type: "object",
+    required: ["patch"],
+    properties: {
+      patch: {
+        type: "string",
+        description:
+          "Unified diff or *** Begin Patch / *** Update File: ... / @@ patch",
+      },
+      dryRun: {
+        type: "boolean",
+        description: "Validate and preview without writing",
+      },
+    },
+  },
+  readonly: false,
+  isBuiltIn: true,
+  preprocess: async (args) => ({
+    args,
+    preview: [
+      {
+        type: "text",
+        content: args.dryRun
+          ? "Will validate the patch without writing"
+          : "Will apply the unified patch atomically",
+      },
+    ],
+  }),
+  run: async (args: { patch: string; dryRun?: boolean }) => {
+    let files = parseBeginPatch(args.patch);
+    if (files.length === 0) {
+      files = parseUnifiedPatch(args.patch);
+    }
+    if (files.length === 0) {
+      throw new Error("No valid update file sections or unified hunks found.");
+    }
+
+    const pending: Array<{
+      filepath: string;
+      oldContent: string;
+      newContent: string;
+    }> = [];
+    for (const file of files) {
+      const resolved = path.resolve(file.filepath);
+      if (!fs.existsSync(resolved) || !fs.statSync(resolved).isFile()) {
+        throw new Error(`File not found: ${file.filepath}`);
+      }
+      const oldContent = fs.readFileSync(resolved, "utf8");
+      let newContent: string;
+      if (file.unified) {
+        const diffLines = applyUnifiedDiff(
+          oldContent,
+          file.body.join("\n"),
+        );
+        newContent = diffLines
+          .filter((line) => line.type !== "old")
+          .map((line) => line.line)
+          .join("\n");
+      } else {
+        newContent = applyCustomHunks(oldContent, file.body);
+      }
+      pending.push({
+        filepath: file.filepath,
+        oldContent,
+        newContent,
+      });
+    }
+
+    if (!args.dryRun) {
+      for (const item of pending) {
+        fs.writeFileSync(path.resolve(item.filepath), item.newContent, "utf8");
+      }
+    }
+    return pending
+      .map((item) =>
+        args.dryRun
+          ? `Would update ${item.filepath}`
+          : `Updated ${item.filepath}`,
+      )
+      .join("\n");
+  },
+};
