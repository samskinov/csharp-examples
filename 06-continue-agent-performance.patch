+import { ToolImpl } from ".";
+import { resolveInputPath } from "../../util/pathResolver";
+import { getNumberArg, getStringArg } from "../parseArgs";
+
+function toCoreLocation(filepath: string, line: number, character: number) {
+  return {
+    filepath,
+    position: {
+      line: Math.max(0, line - 1),
+      character: Math.max(0, character - 1),
+    },
+  };
+}
+
+function formatRanges(
+  ranges: Array<{ filepath: string; range: any }>,
+): string {
+  return ranges
+    .map((item) =>
+      `${item.filepath}:${item.range.start.line + 1}:${item.range.start.character + 1}`,
+    )
+    .join("\n");
+}
+
+export const getReferencesImpl: ToolImpl = async (args, extras) => {
+  const filepath = getStringArg(args, "filepath");
+  const line = getNumberArg(args, "line");
+  const character = getNumberArg(args, "character");
+  const limit =
+    args.limit !== undefined ? getNumberArg(args, "limit") : 200;
+  const resolved = await resolveInputPath(extras.ide, filepath);
+  if (!resolved) {
+    throw new Error(`File not found: ${filepath}`);
+  }
+  const references = await extras.ide.getReferences(
+    toCoreLocation(resolved.uri, line, character),
+  );
+  const limited = references.slice(0, Math.max(1, Math.min(limit, 1000)));
+  return [
+    {
+      name: "References",
+      description: `${limited.length} references`,
+      content:
+        limited.length > 0
+          ? formatRanges(limited)
+          : "No references found.",
+    },
+  ];
+};
+
+export const getDefinitionImpl: ToolImpl = async (args, extras) => {
+  const filepath = getStringArg(args, "filepath");
+  const line = getNumberArg(args, "line");
+  const character = getNumberArg(args, "character");
+  const limit =
+    args.limit !== undefined ? getNumberArg(args, "limit") : 100;
+  const resolved = await resolveInputPath(extras.ide, filepath);
+  if (!resolved) {
+    throw new Error(`File not found: ${filepath}`);
+  }
+  const location = toCoreLocation(resolved.uri, line, character);
+  const definitions = args.includeTypeDefinition
+    ? [
+        ...(await extras.ide.gotoDefinition(location)),
+        ...(await extras.ide.gotoTypeDefinition(location)),
+      ]
+    : await extras.ide.gotoDefinition(location);
+  const unique = definitions.filter(
+    (item, index, all) =>
+      all.findIndex(
+        (candidate) =>
+          candidate.filepath === item.filepath &&
+          candidate.range.start.line === item.range.start.line &&
+          candidate.range.start.character === item.range.start.character,
+      ) === index,
+  );
+  const limited = unique.slice(0, Math.max(1, Math.min(limit, 1000)));
+  return [
+    {
+      name: "Definitions",
+      description: `${limited.length} definitions`,
+      content:
+        limited.length > 0
+          ? formatRanges(limited)
+          : "No definition found.",
+    },
+  ];
+};
+
+export const searchWorkspaceSymbolsImpl: ToolImpl = async (args, extras) => {
+  const query = getStringArg(args, "query");
+  const limit =
+    args.limit !== undefined ? getNumberArg(args, "limit") : 200;
+  if (!extras.ide.getWorkspaceSymbols) {
+    return [
+      {
+        name: "Workspace symbols",
+        description: "Workspace symbol search unavailable",
+        content:
+          "This workspace language server does not support workspace-symbol search.",
+      },
+    ];
+  }
+  const symbols = await extras.ide.getWorkspaceSymbols(query);
+  const kind =
+    typeof args.kind === "string" ? args.kind.toLowerCase() : undefined;
+  const filtered = kind
+    ? symbols.filter((symbol) =>
+        String(symbol.kind ?? "").toLowerCase().includes(kind),
+      )
+    : symbols;
+  const limited = filtered.slice(0, Math.max(1, Math.min(limit, 1000)));
+  return [
+    {
+      name: "Workspace symbols",
+      description: `${limited.length} symbols`,
+      content:
+        limited.length > 0
+          ? limited
+              .map(
+                (symbol) =>
+                  `${symbol.name} ${symbol.filepath}:${symbol.range.start.line + 1}:${symbol.range.start.character + 1}`,
+              )
+              .join("\n")
+          : "No workspace symbols found.",
+    },
+  ];
+};
