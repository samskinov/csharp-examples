+import { Box, Text } from "ink";
+import React, { useEffect, useState } from "react";
+
+import { getDirectorySuggestions } from "../util/workspace.js";
+
+interface DirectorySearchUIProps {
+  filter: string;
+  selectedIndex: number;
+  onSelect: (directory: string) => void;
+  onDirectoriesUpdated?: (directories: string[]) => void;
+}
+
+export const DirectorySearchUI: React.FC<DirectorySearchUIProps> = ({
+  filter,
+  selectedIndex,
+  onDirectoriesUpdated,
+}) => {
+  const [directories, setDirectories] = useState<string[]>([]);
+
+  useEffect(() => {
+    const suggestions = getDirectorySuggestions(filter, 12);
+    setDirectories(suggestions);
+    onDirectoriesUpdated?.(suggestions);
+  }, [filter, onDirectoriesUpdated]);
+
+  if (directories.length === 0) {
+    return (
+      <Box paddingX={1} marginX={1} marginBottom={1}>
+        <Text color="gray">
+          No existing folders found. Type a complete existing path.
+        </Text>
+      </Box>
+    );
+  }
+
+  return (
+    <Box paddingX={1} marginX={1} marginBottom={1} flexDirection="column">
+      {directories.map((directory, index) => (
+        <Text
+          key={directory}
+          color="green"
+          bold={index === selectedIndex}
+        >
+          {index === selectedIndex ? "› " : "  "}
+          {directory}
+        </Text>
+      ))}
+      <Box marginTop={1}>
+        <Text color="gray">
+          ↑/↓ navigate, Enter or Tab select, Escape close
+        </Text>
+      </Box>
+    </Box>
+  );
+};
