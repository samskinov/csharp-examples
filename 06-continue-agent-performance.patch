+export function looksLikeToolAnnouncement(content: string): boolean {
+  const text = content.trim();
+  if (!text) {
+    return false;
+  }
+  const lower = text.toLowerCase();
+  const announcements =
+    /\b(i(?:'|’)ll|i will|i'm going to|i am going to|let me|i need to|i should|i have to|next i(?:'|’)ll|je vais|je dois|je vais devoir|j'utilise|je vais utiliser)\b/i;
