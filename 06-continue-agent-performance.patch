new file mode 100644
index 000000000..a1b72fbb7
--- /dev/null
+++ b/extensions/cli/src/tools/readFileRange.ts
@@ -0,0 +1,137 @@
+import * as fs from "fs";
+import path from "path";
+
+import { ContinueError, ContinueErrorReason } from "core/util/errors.js";
+
+import { parseEnvNumber, truncateByLinesAndChars } from "../util/truncateOutput.js";
+import { formatToolArgument } from "./formatters.js";
+import { markFileRangeAsRead } from "./readFile.js";
+import { Tool } from "./types.js";
+
+const DEFAULT_RANGE_MAX_CHARS = 100000;
+const DEFAULT_RANGE_MAX_LINES = 5000;
+
+function getRangeMaxChars(): number {
+  return parseEnvNumber(
+    process.env.CONTINUE_CLI_READ_RANGE_MAX_OUTPUT_CHARS,
+    DEFAULT_RANGE_MAX_CHARS,
+  );
+}
+
+function getRangeMaxLines(): number {
+  return parseEnvNumber(
+    process.env.CONTINUE_CLI_READ_RANGE_MAX_OUTPUT_LINES,
+    DEFAULT_RANGE_MAX_LINES,
+  );
+}
+
+export const readFileRangeTool: Tool = {
+  name: "ReadRange",
+  displayName: "Read Range",
+  description:
+    "Read a targeted 1-based line range from an existing file. Use this instead of Read for large files.",
+  parameters: {
+    type: "object",
+    required: ["filepath", "startLine", "endLine"],
+    properties: {
+      filepath: {
+        type: "string",
+        description: "Absolute or relative path to the file",
+      },
+      startLine: {
+        type: "number",
+        description: "First line to read, 1-based",
+      },
+      endLine: {
+        type: "number",
+        description: "Last line to read, 1-based",
+      },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  preprocess: async (args) => {
+    const filepath = args?.filepath;
+    if (typeof filepath !== "string" || !filepath.trim()) {
+      throw new Error("filepath is required");
+    }
+    return {
+      args,
+      preview: [
+        {
+          type: "text",
+          content: `Will read ${formatToolArgument(filepath)} lines ${args.startLine}-${args.endLine}`,
+        },
+      ],
+    };
+  },
+  run: async (args: {
+    filepath: string;
+    startLine: number;
+    endLine: number;
+  }): Promise<string> => {
+    const startLine = Number(args.startLine);
+    const endLine = Number(args.endLine);
+    if (!Number.isInteger(startLine) || startLine < 1) {
+      throw new ContinueError(
+        ContinueErrorReason.InvalidLineNumber,
+        "startLine must be a positive integer",
+      );
+    }
+    if (!Number.isInteger(endLine) || endLine < startLine) {
+      throw new ContinueError(
+        ContinueErrorReason.InvalidLineNumber,
+        "endLine must be a positive integer greater than or equal to startLine",
+      );
+    }
+
+    let filepath = args.filepath;
+    if (filepath.startsWith("./")) {
+      filepath = filepath.slice(2);
+    }
+    const resolvedPath = path.resolve(filepath);
+    if (!fs.existsSync(resolvedPath)) {
+      throw new ContinueError(
+        ContinueErrorReason.FileNotFound,
+        `File does not exist: ${filepath}`,
+      );
+    }
+
+    const content = fs.readFileSync(resolvedPath, "utf-8");
+    const lines = content.split(/\r?\n/);
+    const actualEndLine = Math.min(endLine, lines.length);
+    if (startLine > lines.length) {
+      throw new ContinueError(
+        ContinueErrorReason.InvalidLineNumber,
+        `startLine ${startLine} is beyond the end of ${filepath} (${lines.length} lines)`,
+      );
+    }
+
+    const selected = lines
+      .slice(startLine - 1, actualEndLine)
+      .join("\n");
+    const result = truncateByLinesAndChars(
+      selected,
+      getRangeMaxLines(),
+      getRangeMaxChars(),
+      `the requested range in ${filepath}`,
+    );
+
+    markFileRangeAsRead(
+      resolvedPath,
+      startLine,
+      actualEndLine,
+      result.output,
+    );
+
+    return [
+      `Content of ${filepath} (lines ${startLine}-${actualEndLine} of ${lines.length}):`,
+      result.output,
+      actualEndLine < lines.length
+        ? `More content follows after line ${actualEndLine}.`
+        : "",
+    ]
+      .filter(Boolean)
+      .join("\n");
+  },
+};
