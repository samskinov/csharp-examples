+++ b/extensions/cli/src/tools/gitTools.ts
@@ -0,0 +1,98 @@
+import { execFile } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { promisify } from "node:util";
+
+import { Tool } from "./types.js";
+
+const execFileAsync = promisify(execFile);
+
+function resolveRepoPath(input?: string): string {
+  return input ? path.resolve(input) : process.cwd();
+}
+
+async function runGit(repoPath: string, args: string[]): Promise<string> {
+  if (!fs.existsSync(repoPath) || !fs.statSync(repoPath).isDirectory()) {
+    return `Error: path does not exist or is not a directory: ${repoPath}`;
+  }
+  try {
+    const { stdout, stderr } = await execFileAsync("git", [
+      "-C",
+      repoPath,
+      ...args,
+    ]);
+    return [stdout.trim(), stderr.trim()].filter(Boolean).join("\n");
+  } catch (error) {
+    return `Git error: ${error instanceof Error ? error.message : String(error)}`;
+  }
+}
+
+export const gitStatusTool: Tool = {
+  name: "GitStatus",
+  displayName: "Git Status",
+  description: "Show the current git branch and working tree status",
+  parameters: {
+    type: "object",
+    properties: {
+      path: { type: "string", description: "Optional repository path" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: { path?: string }) =>
+    await runGit(resolveRepoPath(args.path), ["status", "--short", "--branch"]),
+};
+
+export const gitDiffTool: Tool = {
+  name: "GitDiff",
+  displayName: "Git Diff",
+  description: "Show uncommitted changes or a diff summary",
+  parameters: {
+    type: "object",
+    properties: {
+      path: { type: "string", description: "Optional repository path" },
+      statOnly: {
+        type: "boolean",
+        description: "Show only file-level change statistics",
+      },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: { path?: string; statOnly?: boolean }) => {
+    const repoPath = resolveRepoPath(args.path);
+    if (args.statOnly) {
+      return await runGit(repoPath, ["diff", "--stat"]);
+    }
+    const stat = await runGit(repoPath, ["diff", "--stat"]);
+    const full = await runGit(repoPath, ["diff"]);
+    return [stat, full].filter((value) => value && !value.startsWith("Git error")).join("\n\n");
+  },
+};
+
+export const gitLogTool: Tool = {
+  name: "GitLog",
+  displayName: "Git Log",
+  description: "Show recent git commits",
+  parameters: {
+    type: "object",
+    properties: {
+      path: { type: "string", description: "Optional repository path" },
+      limit: { type: "number", description: "Maximum commits (default 10)" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: { path?: string; limit?: number }) => {
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 10, 100)
+        : 10;
+    return await runGit(resolveRepoPath(args.path), [
+      "log",
+      `-${limit}`,
+      "--date=short",
+      "--pretty=format:%h %ad %s",
+    ]);
+  },
+};
