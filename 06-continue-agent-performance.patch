@@ -0,0 +1,43 @@
+import { ToolImpl } from ".";
+import { resolveInputPath } from "../../util/pathResolver";
+import { getStringArg } from "../parseArgs";
+
+export const getDocumentSymbolsImpl: ToolImpl = async (args, extras) => {
+  const filepath = getStringArg(args, "filepath");
+  const resolved = await resolveInputPath(extras.ide, filepath);
+  if (!resolved) {
+    throw new Error(`File not found: ${filepath}`);
+  }
+  const limit =
+    Number.isInteger(args.limit) && args.limit > 0
+      ? Math.min(args.limit, 500)
+      : 200;
+  const kind =
+    typeof args.kind === "string" ? args.kind.toLowerCase() : undefined;
+  const symbols = await extras.ide.getDocumentSymbols(resolved.uri);
+  const filtered = kind
+    ? symbols.filter((symbol: any) =>
+        String(symbol.kind ?? "").toLowerCase().includes(kind),
+      )
+    : symbols;
+  const limited = filtered.slice(0, limit);
+  return [
+    {
+      name: "Document Symbols",
+      description: resolved.displayPath,
+      content:
+        limited.length > 0
+          ? limited
+              .map((symbol: any) => {
+                const line =
+                  symbol.range?.start?.line !== undefined
+                    ? `:${symbol.range.start.line + 1}`
+                    : "";
+                return `${symbol.name}${line}`;
+              })
+              .join("\n")
+          : "No symbols found.",
+      uri: { type: "file" as const, value: resolved.uri },
+    },
+  ];
+};
