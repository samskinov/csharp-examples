@@ -0,0 +1,69 @@
+import * as fs from "fs";
+import path from "path";
+
+import {
+  markFileAsRead,
+  markFileRangeAsRead,
+} from "./readFile.js";
+import { Tool } from "./types.js";
+
+export const readManyFilesTool: Tool = {
+  name: "ReadManyFiles",
+  displayName: "Read Many Files",
+  description:
+    "Read multiple known files together. Prefer ReadRange for a large file.",
+  parameters: {
+    type: "object",
+    required: ["filepaths"],
+    properties: {
+      filepaths: {
+        type: "array",
+        description: "List of relative or absolute file paths",
+        items: { type: "string", description: "File path" },
+      },
+      maxCharsPerFile: {
+        type: "number",
+        description: "Optional character limit per file",
+      },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: {
+    filepaths: string[];
+    maxCharsPerFile?: number;
+  }): Promise<string> => {
+    const filepaths = Array.isArray(args.filepaths) ? args.filepaths : [];
+    const limit =
+      Number.isInteger(args.maxCharsPerFile) &&
+      (args.maxCharsPerFile ?? 0) > 0
+        ? Math.min(args.maxCharsPerFile ?? 100000, 500000)
+        : 100000;
+    const sections: string[] = [];
+    for (const filepath of filepaths.slice(0, 20)) {
+      const resolved = path.resolve(filepath);
+      if (!fs.existsSync(resolved) || !fs.statSync(resolved).isFile()) {
+        sections.push(`## ${filepath}\n[File not found]`);
+        continue;
+      }
+      const content = fs.readFileSync(resolved, "utf-8");
+      const truncated =
+        content.length > limit
+          ? content.slice(0, limit) +
+            `\n\n[${content.length - limit} characters truncated; use ReadRange]`
+          : content;
+      if (content.length <= limit) {
+        markFileAsRead(resolved);
+      } else {
+        markFileRangeAsRead(
+          resolved,
+          1,
+          content.slice(0, limit).split(/\r?\n/).length,
+          content.slice(0, limit),
+        );
+      }
+      sections.push(`## ${filepath}\n${truncated}`);
+    }
+    return sections.join("\n\n");
+  },
+};
