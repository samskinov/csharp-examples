diff --git a/core/tools/implementations/applyPatch.ts b/core/tools/implementations/applyPatch.ts
new file mode 100644
index 000000000..263603046
--- /dev/null
+++ b/core/tools/implementations/applyPatch.ts
@@ -0,0 +1,186 @@
+import { ToolImpl } from ".";
+import { resolveInputPath } from "../../util/pathResolver";
+import {
+  applyUnifiedDiff,
+  isUnifiedDiffFormat,
+} from "../../edit/lazy/unifiedDiffApply";
+import { getStringArg } from "../parseArgs";
+
+interface PatchFile {
+  filepath: string;
+  body: string[];
+  unified?: boolean;
+}
+
+function parseBeginPatch(patch: string): PatchFile[] {
+  const files: PatchFile[] = [];
+  let current: PatchFile | undefined;
+  for (const line of patch.replace(/\r\n/g, "\n").split("\n")) {
+    if (line.startsWith("*** Begin Patch")) continue;
+    if (line.startsWith("*** End Patch")) break;
+    const update = line.match(/^\*\*\* (?:Update|Add) File:\s*(.+)$/);
+    if (update) {
+      current = { filepath: update[1].trim(), body: [] };
+      files.push(current);
+      continue;
+    }
+    if (line.startsWith("*** Delete File:")) continue;
+    if (line.startsWith("*** Move to:")) continue;
+    if (current) current.body.push(line);
+  }
+  return files;
+}
+
+function parseUnifiedFiles(patch: string): PatchFile[] {
+  const lines = patch.replace(/\r\n/g, "\n").split("\n");
+  const files: PatchFile[] = [];
+  let current: PatchFile | undefined;
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    if (line.startsWith("--- ")) {
+      const oldPath = line.slice(4).trim();
+      const next = lines[i + 1];
+      if (next?.startsWith("+++ ")) {
+        const newPath = next.slice(4).trim();
+        const filepath =
+          newPath === "/dev/null"
+            ? oldPath
+            : newPath.replace(/^a\/|^b\//, "");
+        current = { filepath, body: [], unified: true };
+        files.push(current);
+        i++;
+        continue;
+      }
+    }
+    if (current?.unified) current.body.push(line);
+  }
+  return files;
+}
+
+function applyCustomHunks(source: string, body: string[]): string {
+  let sourceLines = source.split(/\r?\n/);
+  let hunkLines: string[] = [];
+  const hunks: string[][] = [];
+  for (const line of body) {
+    if (/^@@/.test(line)) {
+      if (hunkLines.length > 0) hunks.push(hunkLines);
+      hunkLines = [];
+    } else if (hunkLines.length >= 0 && !line.startsWith("***")) {
+      hunkLines.push(line);
+    }
+  }
+  if (hunkLines.length > 0) hunks.push(hunkLines);
+
+  for (const hunk of hunks) {
+    const oldLines: string[] = [];
+    const newLines: string[] = [];
+    for (const line of hunk) {
+      if (line.startsWith("+") && !line.startsWith("+++")) {
+        newLines.push(line.slice(1));
+      } else if (line.startsWith("-") && !line.startsWith("---")) {
+        oldLines.push(line.slice(1));
+      } else if (line.startsWith(" ")) {
+        oldLines.push(line.slice(1));
+        newLines.push(line.slice(1));
+      } else if (line === "") {
+        oldLines.push("");
+        newLines.push("");
+      }
+    }
+    if (oldLines.length === 0) {
+      sourceLines = [...newLines, ...sourceLines];
+      continue;
+    }
+    let index = -1;
+    for (let i = 0; i <= sourceLines.length - oldLines.length; i++) {
+      const exact = oldLines.every((line, j) => sourceLines[i + j] === line);
+      if (exact) {
+        index = i;
+        break;
+      }
+    }
+    if (index < 0) {
+      for (let i = 0; i <= sourceLines.length - oldLines.length; i++) {
+        const relaxed = oldLines.every(
+          (line, j) =>
+            sourceLines[i + j]?.replace(/^\s+/, "") ===
+            line.replace(/^\s+/, ""),
+        );
+        if (relaxed) {
+          index = i;
+          break;
+        }
+      }
+    }
+    if (index < 0) {
+      throw new Error(
+        `Patch hunk could not be applied cleanly:\n${oldLines.join("\n")}`,
+      );
+    }
+    sourceLines.splice(index, oldLines.length, ...newLines);
+  }
+  return sourceLines.join("\n");
+}
+
+export const applyPatchImpl: ToolImpl = async (args, extras) => {
+  const patch = getStringArg(args, "patch");
+  let files = parseBeginPatch(patch);
+  if (files.length === 0 && isUnifiedDiffFormat(patch)) {
+    files = parseUnifiedFiles(patch);
+  }
+  if (files.length === 0) {
+    throw new Error("No valid update file sections or unified hunks found.");
+  }
+
+  const pending: Array<{
+    filepath: string;
+    uri: any;
+    oldContent: string;
+    newContent: string;
+  }> = [];
+
+  for (const file of files) {
+    const resolved = await resolveInputPath(extras.ide, file.filepath);
+    if (!resolved) {
+      throw new Error(`File not found: ${file.filepath}`);
+    }
+    const oldContent = await extras.ide.readFile(resolved.uri);
+    let newContent: string;
+    if (file.unified) {
+      const diffLines = applyUnifiedDiff(oldContent, file.body.join("\n"));
+      newContent = diffLines
+        .filter((line) => line.type !== "old")
+        .map((line) => line.line)
+        .join("\n");
+    } else {
+      newContent = applyCustomHunks(oldContent, file.body);
+    }
+    pending.push({
+      filepath: file.filepath,
+      uri: resolved.uri,
+      oldContent,
+      newContent,
+    });
+  }
+
+  if (!args.dryRun) {
+    for (const item of pending) {
+      await extras.ide.writeFile(item.uri, item.newContent);
+    }
+  }
+
+  const summary = pending
+    .map((item) =>
+      args.dryRun
+        ? `Would update ${item.filepath}`
+        : `Updated ${item.filepath}`,
+    )
+    .join("\n");
+  return [
+    {
+      name: "Apply Patch",
+      description: args.dryRun ? "Patch preview" : "Patch applied",
+      content: summary,
+    },
+  ];
+};
