@@ -0,0 +1,42 @@
+import { ToolImpl } from ".";
+import { resolveInputPath } from "../../util/pathResolver";
+import { getNumberArg } from "../parseArgs";
+
+export const readManyFilesImpl: ToolImpl = async (args, extras) => {
+  if (!Array.isArray(args.filepaths)) {
+    throw new Error("filepaths must be an array");
+  }
+  const limit =
+    args.maxCharsPerFile !== undefined
+      ? getNumberArg(args, "maxCharsPerFile")
+      : 100000;
+  const maxChars = Math.max(1000, Math.min(limit, 500000));
+  const items = [];
+  for (const filepath of args.filepaths.slice(0, 20)) {
+    if (typeof filepath !== "string") {
+      continue;
+    }
+    const resolved = await resolveInputPath(extras.ide, filepath);
+    if (!resolved) {
+      items.push({
+        name: filepath,
+        description: "File not found",
+        content: "The file could not be resolved.",
+      });
+      continue;
+    }
+    const content = await extras.ide.readFile(resolved.uri);
+    const truncated =
+      content.length > maxChars
+        ? content.slice(0, maxChars) +
+          `\n\n[${content.length - maxChars} characters truncated; use ReadFileRange]`
+        : content;
+    items.push({
+      name: filepath,
+      description: resolved.displayPath,
+      content: truncated,
+      uri: { type: "file" as const, value: resolved.uri },
+    });
+  }
+  return items;
+};
