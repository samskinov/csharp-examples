+++ b/extensions/cli/src/tools/lspTools.ts
@@ -0,0 +1,220 @@
+import fs from "fs";
+import path from "path";
+import { glob } from "glob";
+
+import { Tool } from "./types.js";
+
+const SOURCE_EXTENSIONS =
+  /\.(cs|ts|tsx|js|jsx|py|go|rs|java|kt|cpp|c|h|hpp|rb|php)$/i;
+
+function readWordAt(
+  lines: string[],
+  line: number,
+  character: number,
+): string {
+  const lineText = lines[Math.max(0, line - 1)] ?? "";
+  const index = Math.max(0, character - 1);
+  if (!lineText[index]?.match(/[A-Za-z0-9_]/)) {
+    const match = lineText.slice(0, index).match(/([A-Za-z_][A-Za-z0-9_]*)$/);
+    if (match) return match[1];
+  }
+  const left = lineText.slice(0, index).match(/([A-Za-z_][A-Za-z0-9_]*)$/)?.[1] ?? "";
+  const right = lineText
+    .slice(index)
+    .match(/^([A-Za-z0-9_]*)/)?.[1] ?? "";
+  return `${left}${right}`;
+}
+
+async function findWorkspaceFiles(
+  cwd: string,
+  limit: number = 500,
+): Promise<string[]> {
+  return await glob(["**/*.{cs,ts,tsx,js,jsx,py,go,rs,java,kt,cpp,c,h,hpp}"], {
+    cwd,
+    absolute: false,
+    nodir: true,
+    dot: false,
+    ignore: [
+      "**/node_modules/**",
+      "**/.git/**",
+      "**/bin/**",
+      "**/obj/**",
+      "**/.vs/**",
+      "**/dist/**",
+      "**/build/**",
+      "**/out/**",
+    ],
+  }).then((files) => files.slice(0, limit));
+}
+
+export const getReferencesTool: Tool = {
+  name: "GetReferences",
+  displayName: "Find References",
+  description:
+    "Find references to a symbol in the workspace using a workspace text scan.",
+  parameters: {
+    type: "object",
+    required: ["filepath", "line", "character"],
+    properties: {
+      filepath: { type: "string", description: "File containing the symbol" },
+      line: { type: "number", description: "1-based line number" },
+      character: { type: "number", description: "1-based character position" },
+      limit: { type: "number", description: "Maximum references" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: {
+    filepath: string;
+    line: number;
+    character: number;
+    limit?: number;
+  }) => {
+    const filepath = path.resolve(args.filepath);
+    if (!fs.existsSync(filepath)) {
+      throw new Error(`File not found: ${args.filepath}`);
+    }
+    const sourceLines = fs.readFileSync(filepath, "utf8").split(/\r?\n/);
+    const symbol = readWordAt(sourceLines, args.line, args.character);
+    if (!symbol) {
+      return "No symbol found at the requested position.";
+    }
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 200, 1000)
+        : 200;
+    const regex = new RegExp(`\\b${symbol.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b`);
+    const files = await findWorkspaceFiles(process.cwd());
+    const matches: string[] = [];
+    for (const rel of files) {
+      const abs = path.resolve(rel);
+      if (!fs.existsSync(abs) || !fs.statSync(abs).isFile()) continue;
+      const content = fs.readFileSync(abs, "utf8");
+      content.split(/\r?\n/).forEach((lineText, index) => {
+        if (regex.test(lineText)) {
+          matches.push(`${rel}:${index + 1}:${lineText.trim()}`);
+        }
+      });
+      if (matches.length >= limit) break;
+    }
+    return matches.length > 0
+      ? `${matches.length} references:\n${matches.slice(0, limit).join("\n")}`
+      : `No references found for ${symbol}.`;
+  },
+};
+
+export const getDefinitionTool: Tool = {
+  name: "GetDefinition",
+  displayName: "Go to Definition",
+  description:
+    "Find likely declarations for a symbol using workspace scanning.",
+  parameters: {
+    type: "object",
+    required: ["filepath", "line", "character"],
+    properties: {
+      filepath: { type: "string", description: "File containing the symbol" },
+      line: { type: "number", description: "1-based line number" },
+      character: { type: "number", description: "1-based character position" },
+      limit: { type: "number", description: "Maximum definitions" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: {
+    filepath: string;
+    line: number;
+    character: number;
+    limit?: number;
+  }) => {
+    const filepath = path.resolve(args.filepath);
+    if (!fs.existsSync(filepath)) {
+      throw new Error(`File not found: ${args.filepath}`);
+    }
+    const sourceLines = fs.readFileSync(filepath, "utf8").split(/\r?\n/);
+    const symbol = readWordAt(sourceLines, args.line, args.character);
+    if (!symbol) return "No symbol found at the requested position.";
+    const escaped = symbol.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+    const declaration =
+      new RegExp(
+        `(class|record|interface|struct|enum|namespace)\\s+${escaped}\\b|(?:public|private|protected|internal|static|sealed|abstract|async|virtual|override|partial|readonly|extern|new|\\s)*\\b${escaped}\\b\\s*(?:\\([^)]*\\)|\\{)`,
+        "i",
+      );
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 100, 1000)
+        : 100;
+    const files = await findWorkspaceFiles(process.cwd());
+    const matches: string[] = [];
+    for (const rel of files) {
+      const abs = path.resolve(rel);
+      const content = fs.readFileSync(abs, "utf8");
+      content.split(/\r?\n/).forEach((lineText, index) => {
+        if (declaration.test(lineText)) {
+          matches.push(`${rel}:${index + 1}:${lineText.trim()}`);
+        }
+      });
+      if (matches.length >= limit) break;
+    }
+    return matches.length > 0
+      ? `Definitions:\n${matches.slice(0, limit).join("\n")}`
+      : `No definition found for ${symbol}.`;
+  },
+};
+
+export const searchWorkspaceSymbolsTool: Tool = {
+  name: "SearchWorkspaceSymbols",
+  displayName: "Search Workspace Symbols",
+  description:
+    "Search workspace classes, interfaces, methods and properties.",
+  parameters: {
+    type: "object",
+    required: ["query"],
+    properties: {
+      query: { type: "string", description: "Symbol name or partial name" },
+      kind: { type: "string", description: "Optional kind filter" },
+      limit: { type: "number", description: "Maximum symbols" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: {
+    query: string;
+    kind?: string;
+    limit?: number;
+  }) => {
+    const escaped = args.query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+    const patterns = [
+      new RegExp(
+        `\\b(class|record|interface|struct|enum)\\s+${escaped}[A-Za-z0-9_]*\\b`,
+        "i",
+      ),
+      new RegExp(
+        `\\b(namespace)\\s+${escaped}[A-Za-z0-9_.]*\\b`,
+        "i",
+      ),
+      new RegExp(
+        `\\b[A-Za-z_]([A-Za-z0-9_]*)${escaped}[A-Za-z0-9_]*\\b\\s*(?:\\([^;]*\\)\\s*(?:=>|\\{|;))`,
+        "i",
+      ),
+    ];
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 200, 1000)
+        : 200;
+    const files = await findWorkspaceFiles(process.cwd());
+    const symbols: string[] = [];
+    for (const rel of files) {
+      const abs = path.resolve(rel);
+      const content = fs.readFileSync(abs, "utf8");
+      content.split(/\r?\n/).forEach((lineText, index) => {
+        if (patterns.some((regex) => regex.test(lineText))) {
+          symbols.push(`${rel}:${index + 1}:${lineText.trim()}`);
+        }
+      });
+      if (symbols.length >= limit) break;
+    }
+    return symbols.length > 0
+      ? symbols.slice(0, limit).join("\n")
+      : "No workspace symbols found.";
