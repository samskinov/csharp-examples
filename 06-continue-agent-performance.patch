+import { ToolImpl } from ".";
+
+export const getProblemsImpl: ToolImpl = async (args, extras) => {
+  const filepath =
+    typeof args.filepath === "string" ? args.filepath : undefined;
+  const severity =
+    typeof args.severity === "string" ? args.severity.toLowerCase() : undefined;
+  const limit =
+    Number.isInteger(args.limit) && args.limit > 0
+      ? Math.min(args.limit, 500)
+      : 200;
+  const problems = await extras.ide.getProblems(filepath);
+  const filtered = severity
+    ? problems.filter(
+        (problem: any) =>
+          String(problem.severity ?? "").toLowerCase() === severity,
+      )
+    : problems;
+  const limited = filtered.slice(0, limit);
+  if (limited.length === 0) {
+    return [
+      {
+        name: "Problems",
+        description: "Diagnostics",
+        content: "No problems found.",
+      },
+    ];
+  }
+  return [
+    {
+      name: "Problems",
+      description: `${limited.length} diagnostics`,
+      content: limited
+        .map((problem: any) => {
+          const line = problem.range?.start?.line;
+          return `${problem.filepath}${line !== undefined ? `:${line + 1}` : ""}: ${problem.message}`;
+        })
+        .join("\n"),
+    },
+  ];
+};
