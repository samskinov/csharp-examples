+import { execFile } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { promisify } from "node:util";
+
+import { glob } from "glob";
+
+import { Tool } from "./types.js";
+
+const execFileAsync = promisify(execFile);
+
+function findDotnetExecutable(): string | undefined {
+  const roots = [
+    process.env.DOTNET_ROOT,
+    process.env.DOTNET_ROOT_X64,
+    process.env.ProgramFiles
+      ? path.join(process.env.ProgramFiles, "dotnet")
+      : undefined,
+    process.env["ProgramFiles(x86)"]
+      ? path.join(process.env["ProgramFiles(x86)"], "dotnet")
+      : undefined,
+    process.env.HOME ? path.join(process.env.HOME, ".dotnet") : undefined,
+  ].filter((value): value is string => !!value);
+  for (const root of roots) {
+    const candidate = process.platform === "win32"
+      ? path.join(root, "dotnet.exe")
+      : path.join(root, "dotnet");
+    if (fs.existsSync(candidate)) {
+      return candidate;
+    }
+  }
+  return undefined;
+}
+
+function findMSBuildExecutable(): string | undefined {
+  if (process.platform !== "win32") {
+    return undefined;
+  }
+  const roots = [
+    process.env.ProgramFiles
+      ? path.join(process.env.ProgramFiles, "Microsoft Visual Studio")
+      : undefined,
+    process.env["ProgramFiles(x86)"]
+      ? path.join(process.env["ProgramFiles(x86)"], "Microsoft Visual Studio")
+      : undefined,
+  ].filter((value): value is string => !!value);
+  for (const root of roots) {
+    if (!fs.existsSync(root)) continue;
+    for (const year of ["2022", "2019", "2017"]) {
+      const yearDir = path.join(root, year);
+      if (!fs.existsSync(yearDir)) continue;
+      for (const edition of ["Enterprise", "Professional", "Community", "BuildTools"]) {
+        const candidate = path.join(
+          yearDir,
+          edition,
+          "MSBuild",
+          "Current",
+          "Bin",
+          "MSBuild.exe",
+        );
+        if (fs.existsSync(candidate)) {
+          return candidate;
+        }
+      }
+    }
+  }
+  return undefined;
+}
+
+function resolveTarget(target?: string, cwd: string = process.cwd()) {
+  if (!target) {
+    return cwd;
+  }
+  return path.resolve(cwd, target);
+}
+
+async function runDotnet(
+  cwd: string,
+  args: string[],
+): Promise<string> {
+  const executable = findDotnetExecutable();
+  if (!executable) {
+    try {
+      const { stdout, stderr } = await execFileAsync("dotnet", ["--version"], {
+        cwd,
+      });
+      if (stdout.trim()) {
+        const fallback = await execFileAsync("dotnet", args, { cwd });
+        return [fallback.stdout.trim(), fallback.stderr.trim()]
+          .filter(Boolean)
+          .join("\n");
+      }
+      return [stdout.trim(), stderr.trim()].filter(Boolean).join("\n");
+    } catch (error) {
+      const msbuild = findMSBuildExecutable();
+      if (msbuild && args[0] === "build") {
+        const msbuildArgs: string[] = [];
+        for (let i = 1; i < args.length; i++) {
+          const arg = args[i];
+          if (arg === "-c" && args[i + 1]) {
+            msbuildArgs.push(`/p:Configuration=${args[i + 1]}`);
+            i++;
+          } else if (
+            arg !== "--no-restore" &&
+            arg !== "--nologo" &&
+            !arg.startsWith("-v:")
+          ) {
+            msbuildArgs.push(arg);
+          }
+        }
+        try {
+          const result = await execFileAsync(msbuild, [
+            ...msbuildArgs,
+            "/nologo",
+            "/m",
+          ], { cwd });
+          return [result.stdout.trim(), result.stderr.trim()]
+            .filter(Boolean)
+            .join("\n");
+        } catch (msbuildError) {
+          return `No usable dotnet executable or Visual Studio MSBuild found. ${msbuildError instanceof Error ? msbuildError.message : String(msbuildError)}`;
+        }
+      }
+      return `No dotnet executable found on PATH or in DOTNET_ROOT/Program Files. ${error instanceof Error ? error.message : String(error)}`;
+    }
+  }
+  try {
+    const { stdout, stderr } = await execFileAsync(executable, args, { cwd });
+    return [stdout.trim(), stderr.trim()].filter(Boolean).join("\n");
+  } catch (error) {
+    const execError = error as {
+      stdout?: string;
+      stderr?: string;
+      message?: string;
+    };
+    return [
+      execError.stdout?.trim(),
+      execError.stderr?.trim(),
+      execError.message,
+    ]
+      .filter(Boolean)
+      .join("\n");
+  }
+}
+
+export const dotnetProjectsTool: Tool = {
+  name: "DotnetProjects",
+  displayName: "Dotnet Projects",
+  description:
+    "Find .sln, .slnx and .csproj files in the current workspace",
+  parameters: {
+    type: "object",
+    properties: {
+      path: { type: "string", description: "Optional workspace path" },
+      limit: { type: "number", description: "Maximum results" },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: { path?: string; limit?: number }) => {
+    const cwd = resolveTarget(args.path);
+    const limit =
+      Number.isInteger(args.limit) && (args.limit ?? 0) > 0
+        ? Math.min(args.limit ?? 100, 500)
+        : 100;
+    const matches = await glob(["**/*.sln", "**/*.slnx", "**/*.csproj"], {
+      cwd,
+      absolute: false,
+      nodir: true,
+      dot: false,
+      ignore: [
+        "**/node_modules/**",
+        "**/.git/**",
+        "**/bin/**",
+        "**/obj/**",
+        "**/.vs/**",
+      ],
+    });
+    const limited = matches.slice(0, limit);
+    return limited.length > 0
+      ? `Dotnet project/solution files:\n${limited.join("\n")}`
+      : "No .NET solution or project files found.";
+  },
+};
+
+export const dotnetBuildTool: Tool = {
+  name: "DotnetBuild",
+  displayName: "Dotnet Build",
+  description:
+    "Build a .NET solution or project and return compiler output",
+  parameters: {
+    type: "object",
+    properties: {
+      path: {
+        type: "string",
+        description: "Optional project, solution or workspace path",
+      },
+      configuration: {
+        type: "string",
+        description: "Optional configuration such as Debug or Release",
+      },
+      noRestore: {
+        type: "boolean",
+        description: "Add --no-restore",
+      },
+    },
+  },
+  readonly: false,
+  isBuiltIn: true,
+  run: async (args: {
+    path?: string;
+    configuration?: string;
+    noRestore?: boolean;
+  }) => {
+    const cwd = resolveTarget(args.path);
+    const target = fs.existsSync(cwd) && fs.statSync(cwd).isDirectory()
+      ? cwd
+      : path.dirname(cwd);
+    const targetArg =
+      fs.existsSync(cwd) && !fs.statSync(cwd).isDirectory() ? cwd : undefined;
+    const dotnetArgs = ["build"];
+    if (targetArg) {
+      dotnetArgs.push(targetArg);
+    }
+    if (args.configuration) {
+      dotnetArgs.push("-c", args.configuration);
+    }
+    if (args.noRestore) {
+      dotnetArgs.push("--no-restore");
+    }
+    dotnetArgs.push("--nologo", "-v:minimal");
+    return await runDotnet(target, dotnetArgs);
+  },
+};
+
+export const dotnetTestTool: Tool = {
+  name: "DotnetTest",
+  displayName: "Dotnet Test",
+  description:
+    "Run .NET tests for a solution/project or workspace",
+  parameters: {
+    type: "object",
+    properties: {
+      path: {
+        type: "string",
+        description: "Optional project, solution or workspace path",
+      },
+      filter: {
+        type: "string",
+        description: "Optional dotnet test filter",
+      },
+      noBuild: {
+        type: "boolean",
+        description: "Add --no-build",
+      },
+    },
+  },
+  readonly: false,
+  isBuiltIn: true,
+  run: async (args: {
+    path?: string;
+    filter?: string;
+    noBuild?: boolean;
+  }) => {
+    const cwd = resolveTarget(args.path);
+    const target = fs.existsSync(cwd) && fs.statSync(cwd).isDirectory()
+      ? cwd
+      : path.dirname(cwd);
+    const targetArg =
+      fs.existsSync(cwd) && !fs.statSync(cwd).isDirectory() ? cwd : undefined;
+    const dotnetArgs = ["test"];
+    if (targetArg) {
+      dotnetArgs.push(targetArg);
+    }
+    if (args.filter) {
+      dotnetArgs.push("--filter", args.filter);
+    }
+    if (args.noBuild) {
+      dotnetArgs.push("--no-build");
+    }
+    dotnetArgs.push("--nologo");
+    return await runDotnet(target, dotnetArgs);
+  },
+};
+
+export const dotnetFormatCheckTool: Tool = {
+  name: "DotnetFormatCheck",
+  displayName: "Dotnet Format Check",
+  description:
+    "Check formatting with dotnet format --verify-no-changes",
+  parameters: {
+    type: "object",
+    properties: {
+      path: {
+        type: "string",
+        description: "Optional project, solution or workspace path",
+      },
+      noRestore: {
+        type: "boolean",
+        description: "Add --no-restore",
+      },
+    },
+  },
+  readonly: true,
+  isBuiltIn: true,
+  run: async (args: { path?: string; noRestore?: boolean }) => {
+    const cwd = resolveTarget(args.path);
+    const target = fs.existsSync(cwd) && fs.statSync(cwd).isDirectory()
+      ? cwd
+      : path.dirname(cwd);
+    const targetArg =
+      fs.existsSync(cwd) && !fs.statSync(cwd).isDirectory() ? cwd : undefined;
+    const dotnetArgs = ["format"];
+    if (targetArg) {
+      dotnetArgs.push(targetArg);
+    }
+    dotnetArgs.push("--verify-no-changes");
+    if (args.noRestore) {
+      dotnetArgs.push("--no-restore");
+    }
+    return await runDotnet(target, dotnetArgs);
+  },
+};
