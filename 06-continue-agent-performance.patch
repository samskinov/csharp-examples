@@ -0,0 +1,63 @@
+import { ToolImpl } from ".";
+import { getNumberArg, getStringArg } from "../parseArgs";
+
+export const gitStatusImpl: ToolImpl = async (args, extras) => {
+  const cwd = args.path ? getStringArg(args, "path") : undefined;
+  const [stdout, stderr] = await extras.ide.subprocess(
+    "git status --short --branch",
+    cwd,
+  );
+  return [
+    {
+      name: "Git Status",
+      description: "Working tree status",
+      content: [stdout.trim(), stderr.trim()].filter(Boolean).join("\n"),
+    },
+  ];
+};
+
+export const gitDiffImpl: ToolImpl = async (args, extras) => {
+  const cwd = args.path ? getStringArg(args, "path") : undefined;
+  const statOnly = args.statOnly === true;
+  const [statOut, statErr] = await extras.ide.subprocess(
+    "git diff --stat",
+    cwd,
+  );
+  if (statOnly) {
+    return [
+      {
+        name: "Git Diff",
+        description: "Uncommitted change summary",
+        content: [statOut.trim(), statErr.trim()].filter(Boolean).join("\n"),
+      },
+    ];
+  }
+  const [diffOut, diffErr] = await extras.ide.subprocess("git diff", cwd);
+  return [
+    {
+      name: "Git Diff",
+      description: "Uncommitted changes",
+      content: [statOut.trim(), statErr.trim(), diffOut.trim(), diffErr.trim()]
+        .filter(Boolean)
+        .join("\n"),
+    },
+  ];
+};
+
+export const gitLogImpl: ToolImpl = async (args, extras) => {
+  const cwd = args.path ? getStringArg(args, "path") : undefined;
+  const limit =
+    args.limit !== undefined ? getNumberArg(args, "limit") : 10;
+  const capped = Math.max(1, Math.min(limit, 100));
+  const [stdout, stderr] = await extras.ide.subprocess(
+    `git log -${capped} --date=short --pretty=format:%h %ad %s`,
+    cwd,
+  );
+  return [
+    {
+      name: "Git Log",
+      description: "Recent commits",
+      content: [stdout.trim(), stderr.trim()].filter(Boolean).join("\n"),
+    },
+  ];
+};
