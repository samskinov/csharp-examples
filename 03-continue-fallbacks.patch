index 000000000..9103af8d5
--- /dev/null
+++ b/extensions/vscode/src/util/nativeSearch.ts
@@ -0,0 +1,287 @@
+/**
+ * Built-in Node search replacing the ripgrep binary dependency.
+ *
+ * Produces the same output shape as `rg --heading --color never -C 2`:
+ * blocks of `./relative/path` followed by (line: content) matches with up to
+ * `contextLines` lines of context, separated by `--` between match groups.
+ *
+ * Uses the same ignore rules as the rest of the codebase: DEFAULT_IGNORES
+ * directories plus `.gitignore`/`.continueignore` files.
+ */
+
+import * as fs from "node:fs";
+import * as path from "node:path";
+
+import { DEFAULT_IGNORES } from "core/indexing/ignore";
+
+const DEFAULT_CONTEXT_LINES = 2;
+const DEFAULT_MAX_FILE_BYTES = 2 * 1024 * 1024; // 2 MB per file
+const BINARY_SNIFF_BYTES = 1024;
+
+/** Directories never traversed (from DEFAULT_IGNORES + structural dirs). */
+const SKIP_DIRS = new Set(
+  DEFAULT_IGNORES.map((entry: string) =>
+    entry.replace(/^\*\*\//, "").replace(/\/\*\*$/, ""),
+  )
+    .concat([
+      "node_modules",
+      ".git",
+      ".continue",
+      ".vscode",
+      "build",
+      "dist",
+      "out",
+      "venv",
+      ".venv",
+    ])
+    .map((entry: string) => entry.toLowerCase()),
+);
+
+interface IgnoreRules {
+  /** Returns true when a RELATIVE path (posix separators) should be skipped. */
+  isIgnored: (relPath: string) => boolean;
+}
+
+function loadIgnoreFile(dir: string, fileName: string, rules: string[]): void {
+  const ignorePath = path.join(dir, fileName);
+  try {
+    if (!fs.existsSync(ignorePath)) return;
+    const content = fs.readFileSync(ignorePath, "utf8");
+    for (const rawLine of content.split("\n")) {
+      const line = rawLine.trim();
+      if (!line || line.startsWith("#") || line.startsWith("!")) continue;
+      rules.push(line.replace(/\\/g, "/").replace(/\/$/, ""));
+    }
+  } catch {
+    // Unreadable ignore file - ignore it
+  }
+}
+
+function loadIgnoreRules(dir: string): IgnoreRules {
+  const rules: string[] = [];
+  loadIgnoreFile(dir, ".gitignore", rules);
+  loadIgnoreFile(dir, ".continueignore", rules);
+
+  const patterns = rules.map((rule) => {
+    // Minimal gitignore-style matching: leading/trailing slashes and * wildcards
+    let prefix = "";
+    let body = rule;
+    if (body.startsWith("/")) {
+      prefix = "^";
+      body = body.slice(1);
+    } else {
+      prefix = "(^|/)";
+    }
+    const escaped = body
+      .replace(/[.+^${}()|[\]\\]/g, "\\$&")
+      .replace(/\*\*\//g, "(.*/)?")
+      .replace(/\*\*/g, ".*")
+      .replace(/\*/g, "[^/]*")
+      .replace(/\?/g, "[^/]");
+    return { regexp: new RegExp(`${prefix}${escaped}(/.*)?$`), rule };
+  });
+
+  return {
+    isIgnored: (relPath: string) => {
+      const posix = relPath.replace(/\\/g, "/");
+      return patterns.some(({ regexp }) => regexp.test(posix));
+    },
+  };
+}
+
+function isProbablyBinary(buffer: Buffer): boolean {
+  const sample = buffer.subarray(
+    0,
+    Math.min(BINARY_SNIFF_BYTES, buffer.length),
+  );
+  return sample.includes(0);
+}
+
+interface WalkFile {
+  absPath: string;
+  relPath: string;
+}
+
+/** Iterative directory walk respecting the ignore rules. */
+function* walkFiles(
+  dir: string,
+  relBase: string,
+  rules: IgnoreRules,
+  maxDepth: number,
+): Generator<WalkFile> {
+  let entries: fs.Dirent[];
+  try {
+    entries = fs.readdirSync(dir, { withFileTypes: true });
+  } catch {
+    return;
+  }
+
+  for (const entry of entries) {
+    if (relBase.split("/").filter(Boolean).length >= maxDepth) {
+      return;
+    }
+    const name = entry.name;
+    const absPath = path.join(dir, name);
+    const relPath = relBase ? `${relBase}/${name}` : name;
+
+    if (entry.isDirectory()) {
+      if (SKIP_DIRS.has(name.toLowerCase()) || rules.isIgnored(`${relPath}/`)) {
+        continue;
+      }
+      yield* walkFiles(absPath, relPath, rules, maxDepth);
+    } else if (entry.isFile()) {
+      if (rules.isIgnored(relPath)) continue;
+      yield { absPath, relPath };
+    }
+  }
+}
+
+function globToRegExp(globPattern: string): RegExp {
+  const normalized = globPattern.replace(/^\.\//, "").replace(/\\/g, "/");
+  let source = "";
+  let i = 0;
+  while (i < normalized.length) {
+    const char = normalized[i];
+    if (char === "*") {
+      if (normalized[i + 1] === "*") {
+        // `**/` or `**`
+        if (normalized[i + 2] === "/") {
+          source += "(.*/)?";
+          i += 3;
+        } else {
+          source += ".*";
+          i += 2;
+        }
+      } else {
+        source += "[^/]*";
+        i += 1;
+      }
+    } else if (char === "?") {
+      source += "[^/]";
+      i += 1;
+    } else if (char === "{") {
+      // Alternate the simple `{a,b}` form
+      const closeIndex = normalized.indexOf("}", i);
+      const body = normalized.slice(i + 1, closeIndex);
+      source += `(${body
+        .split(",")
+        .map((part) => globToRegExp(part).source.replace(/^\^|\$$/g, ""))
+        .join("|")})`;
+      i = closeIndex + 1;
+    } else {
+      source += char.replace(/[.+^${}()|[\]\\]/g, "\\$&");
+      i += 1;
+    }
+  }
+  return new RegExp(`^${source}$`);
+}
+
+/** Search files under a directory; returns rg-shaped output. */
+export function searchNative(
+  dirFsPath: string,
+  query: string,
+  maxResults?: number,
+  contextLines: number = DEFAULT_CONTEXT_LINES,
+): string {
+  const rules = loadIgnoreRules(dirFsPath);
+  let regex: RegExp;
+  try {
+    regex = new RegExp(query, "i");
+  } catch {
+    // Fall back to a literal search for invalid regexes
+    regex = new RegExp(query.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"), "i");
+  }
+
+  const maxMatches = maxResults ?? 200;
+  let output = "";
+  let matchCount = 0;
+  let truncated = false;
+
+  for (const file of walkFiles(dirFsPath, "", rules, 20)) {
+    if (matchCount >= maxMatches) {
+      truncated = true;
+      break;
+    }
+
+    let stat: fs.Stats;
+    try {
+      stat = fs.statSync(file.absPath);
+    } catch {
+      continue;
+    }
+    if (stat.size > DEFAULT_MAX_FILE_BYTES) continue;
+
+    let content: Buffer;
+    try {
+      content = fs.readFileSync(file.absPath);
+    } catch {
+      continue;
+    }
+    if (isProbablyBinary(content)) continue;
+
+    const lines = content.toString("utf8").split("\n");
+    let fileHasMatches = false;
+    let printedLines: { num: number; text: string }[] = [];
+    let lastMatchNum = -Infinity;
+
+    for (let lineNum = 0; lineNum < lines.length; lineNum++) {
+      if (regex.test(lines[lineNum])) {
+        matchCount++;
+        fileHasMatches = true;
+        const start = Math.max(0, lineNum - contextLines);
+        const end = Math.min(lines.length - 1, lineNum + contextLines);
+        for (let n = start; n <= end; n++) {
+          if (!printedLines.some((p) => p.num === n)) {
+            printedLines.push({ num: n, text: lines[n] });
+          }
+        }
+        lastMatchNum = lineNum;
+        printedLines = printedLines.sort((a, b) => a.num - b.num);
+        void lastMatchNum;
+        if (matchCount >= maxMatches) {
+          truncated = true;
+          break;
+        }
+      }
+    }
+
+    if (fileHasMatches) {
+      if (output.length > 0) {
+        output += "\n";
+      }
+      output += `./${file.relPath}\n`;
+      output += `${printedLines.map((p) => `${p.num + 1}:${p.text}`).join("\n")}\n`;
+    }
+
+    if (truncated) break;
+  }
+
+  if (matchCount === 0) {
+    return "No matches found. Build, secrets, etc. dirs and files are not included.";
+  }
+
+  if (truncated) {
+    output = `Showing up to ${maxMatches} matches\n${output}`;
+  }
+  return output;
+}
+
+/** List files under a directory matching a glob pattern; returns rg --files-shaped output. */
+export function listFilesNative(
+  dirFsPath: string,
+  globPattern: string,
+  maxResults?: number,
+): string {
+  const rules = loadIgnoreRules(dirFsPath);
+  const globRegExp = globToRegExp(globPattern);
+
+  const results: string[] = [];
+  for (const file of walkFiles(dirFsPath, "", rules, 20)) {
+    if (maxResults && results.length >= maxResults) break;
+    if (globRegExp.test(file.relPath)) {
+      results.push(file.relPath);
+    }
+  }
+
+  return results.join("\n");
+}
