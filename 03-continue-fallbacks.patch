diff --git a/core/util/sqliteBackend.test.ts b/core/util/sqliteBackend.test.ts
new file mode 100644
index 000000000..2216ee6ca
--- /dev/null
+++ b/core/util/sqliteBackend.test.ts
@@ -0,0 +1,87 @@
+/**
+ * Tests for the unified SQLite backend (node-sqlite3-wasm).
+ */
+
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+
+import { openDatabase } from "./sqliteBackend.js";
+
+function makeTempDbPath(): string {
+  return path.join(
+    fs.mkdtempSync(path.join(os.tmpdir(), "sqlite-backend-test-")),
+    "test.db",
+  );
+}
+
+describe("openDatabase (node-sqlite3-wasm)", () => {
+  it("runs the full run / get / all / exec / prepare surface", async () => {
+    const db = await openDatabase({
+      filename: makeTempDbPath(),
+    });
+
+    await db.exec("CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT)");
+    const insert = await db.run("INSERT INTO items (name) VALUES (?)", "alpha");
+    expect(insert.changes).toBe(1);
+    expect(insert.lastID ?? insert.lastInsertRowid).toBeTruthy();
+
+    await db.run("INSERT INTO items (name) VALUES (?)", "beta");
+
+    const all = await db.all<{ id: number; name: string }[]>(
+      "SELECT id, name FROM items ORDER BY id",
+    );
+    expect(all).toHaveLength(2);
+    expect(all[0].name).toBe("alpha");
+
+    const one = await db.get<{ name: string }>(
+      "SELECT name FROM items WHERE name = ?",
+      "beta",
+    );
+    expect(one?.name).toBe("beta");
+
+    // Variadic positional binding (sqlite package style)
+    const variadic = await db.all(
+      "SELECT name FROM items WHERE name = ? AND id > ?",
+      "alpha",
+      0,
+    );
+    expect(variadic).toHaveLength(1);
+
+    // prepare + statement with binds at query time
+    const stmt = await db.prepare("SELECT name FROM items WHERE name = ?");
+    const stmtRows = await stmt.all("alpha");
+    fs.writeFileSync("/tmp/stmt-rows-debug.json", JSON.stringify(stmtRows));
+    expect(stmtRows.length).toBe(1);
+    expect(await stmt.get("beta")).toMatchObject({ name: "beta" });
+
+    // Named parameters (object binding)
+    const named = await db.all("SELECT name FROM items WHERE name = :name", {
+      ":name": "alpha",
+    });
+    expect(named).toHaveLength(1);
+
+    // lastID alias normalization on run results
+    // NOTE: the raw driver result may expose lastID instead of lastInsertRowid
+    // (lastID only) depending on the driver; both keys are normalized.
+    const withId = await db.run("INSERT INTO items (name) VALUES (?)", "gamma");
+    expect(withId.lastID).toBe(3);
+    expect(Number(withId.lastInsertRowid ?? withId.lastID)).toBe(3);
+
+    await db.close();
+  });
+
+  it("supports transactions and PRAGMAs", async () => {
+    const db = await openDatabase({
+      filename: makeTempDbPath(),
+    });
+
+    await db.exec("PRAGMA busy_timeout = 3000;");
+    await db.exec("CREATE TABLE t (v TEXT)");
+    await db.exec("BEGIN");
+    await db.run("INSERT INTO t (v) VALUES (?)", "x");
+    await db.run("ROLLBACK");
+    const rows = await db.all("SELECT * FROM t");
+    expect(rows).toHaveLength(0);
+  });
+});
diff --git a/core/util/sqliteBackend.ts b/core/util/sqliteBackend.ts
new file mode 100644
index 000000000..6e225de9f
--- /dev/null
+++ b/core/util/sqliteBackend.ts
@@ -0,0 +1,108 @@
+/**
+ * SQLite backend for core, backed by `node-sqlite3-wasm` (pure WebAssembly,
+ * installed from the npm registry - no native binary, no GitHub download,
+ * no install scripts). Replaces the native `sqlite3` driver dependency.
+ *
+ * The exposed surface mirrors the promise-based API of the `sqlite` package
+ * for the subset core uses: run / get / all / exec / prepare / close, with
+ * the raw-driver `lastID` normalized onto run results.
+ */
+
+export interface SqliteRunResult {
+  changes: number;
+  lastInsertRowid: number | bigint;
+  /** Alias of lastInsertRowid, kept for code written against the raw driver. */
+  lastID?: number | bigint;
+}
+
+export interface SqliteStatement {
+  all(...values: any[]): Promise<any[]>;
+  get(...values: any[]): Promise<any>;
+  run(...values: any[]): Promise<SqliteRunResult>;
+}
+
+export interface SqliteDatabaseLike {
+  /** Variadic like the sqlite package: (sql, objectParam) or (sql, p1, p2, ...). */
+  run(sql: string, ...values: any[]): Promise<SqliteRunResult>;
+  /** Same generic shape as the sqlite package: T is the FULL result type. */
+  all<T = any[]>(sql: string, ...values: any[]): Promise<T>;
+  get<T = any>(sql: string, ...values: any[]): Promise<T | undefined>;
+  exec(sql: string): Promise<void>;
+  prepare(sql: string, ...values: any[]): Promise<SqliteStatement>;
+  close(): Promise<void> | void;
+}
+
+export interface SqliteOpenOptions {
+  filename: string;
+  /** Fail instead of creating the file when it does not exist (default false). */
+  fileMustExist?: boolean;
+}
+
+/**
+ * Opens a SQLite database with the same promise-based surface as the `sqlite`
+ * package, backed by the native driver when possible and by WASM otherwise.
+ */
+export async function openDatabase(
+  options: SqliteOpenOptions,
+): Promise<SqliteDatabaseLike> {
+  const mod: any = await import("node-sqlite3-wasm");
+  const Database = mod.default?.Database ?? mod.Database;
+  const wasmDb = new Database(options.filename, {
+    fileMustExist: options.fileMustExist ?? false,
+  });
+  return new WasmSqliteDatabase(wasmDb);
+}
+
+/**
+ * Adapter over node-sqlite3-wasm's synchronous API exposing the async surface
+ * of the `sqlite` package used throughout core.
+ */
+class WasmSqliteDatabase implements SqliteDatabaseLike {
+  constructor(private readonly wasmDb: any) {}
+
+  async run(sql: string, ...values: any[]): Promise<SqliteRunResult> {
+    const result = this.wasmDb.run(sql, normalizeBindValues(values));
+    return {
+      changes: result?.changes ?? 0,
+      lastInsertRowid: result?.lastInsertRowid ?? 0,
+      lastID: result?.lastInsertRowid ?? 0,
+    };
+  }
+
+  async all<T = any[]>(sql: string, ...values: any[]): Promise<T> {
+    return (await this.wasmDb.all(sql, normalizeBindValues(values))) as T;
+  }
+
+  async get<T = any>(sql: string, ...values: any[]): Promise<T | undefined> {
+    return (await this.wasmDb.get(sql, normalizeBindValues(values))) as
+      | T
+      | undefined;
+  }
+
+  async exec(sql: string): Promise<void> {
+    this.wasmDb.exec(sql);
+  }
+
+  async prepare(sql: string, ...values: any[]): Promise<SqliteStatement> {
+    return {
+      all: async (...binds: any[]) =>
+        this.all(sql, ...(binds.length ? binds : values)),
+      get: async (...binds: any[]) =>
+        this.get(sql, ...(binds.length ? binds : values)),
+      run: async (...binds: any[]) =>
+        this.run(sql, ...(binds.length ? binds : values)),
+    };
+  }
+
+  async close(): Promise<void> {
+    this.wasmDb.close();
+  }
+}
+
+/** node-sqlite3-wasm takes ONE bind value (object | array | scalar); the
+ * `sqlite` package API allows variadic scalars - normalize between the two. */
+function normalizeBindValues(values: any[]): any {
+  if (values.length === 0) return undefined;
+  if (values.length === 1) return values[0];
+  return values;
+}
