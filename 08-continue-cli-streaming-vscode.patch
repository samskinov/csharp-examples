+import { render } from "ink-testing-library";
+import React from "react";
+
+import { StreamingContent } from "./StreamingContent.js";
+
+describe("StreamingContent", () => {
+  it("keeps a fixed tail so streaming does not resize the terminal", () => {
+    const content = Array.from({ length: 20 }, (_, i) => `line ${i}`).join(
+      "\n",
+    );
+
+    const { lastFrame } = render(<StreamingContent content={content} />);
+    const frame = lastFrame() ?? "";
+    const lines = frame.split("\n");
+
+    expect(frame).toContain("line 19");
+    expect(frame).not.toContain("line 0\n");
+    expect(lines.length).toBeLessThanOrEqual(10);
+  });
+
+  it("keeps the same frame height as content grows", () => {
+    const { lastFrame, rerender } = render(
+      <StreamingContent content="first line" />,
+    );
+    const initialHeight = (lastFrame() ?? "").split("\n").length;
+
+    rerender(
+      <StreamingContent content={Array.from({ length: 20 }, (_, i) => `line ${i}`).join("\n")} />,
+    );
+
+    expect((lastFrame() ?? "").split("\n").length).toBe(initialHeight);
+  });
+
+  it("still renders a status line before the first token", () => {
+    const { lastFrame } = render(<StreamingContent content="" />);
+    expect(lastFrame()).toContain("●");
+  });
+});
diff --git a/extensions/cli/src/ui/components/StreamingContent.tsx b/extensions/cli/src/ui/components/StreamingContent.tsx
