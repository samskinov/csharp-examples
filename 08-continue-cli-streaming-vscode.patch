@@ -1,7 +1,32 @@
 import { globalAgent } from "https";
+import * as tls from "node:tls";
+
+function systemCertificatesFromNode(): string[] | undefined {
+  // Node 22.15+ can read the operating system trust store itself. Prefer it
+  // over native addons: a mismatched win-ca/mac-ca binary can abort the VS
+  // Code extension host on Windows before activation reports a JS error.
+  const getCACertificates = (
+    tls as { getCACertificates?: (type: string) => string[] }
+  ).getCACertificates;
+  if (typeof getCACertificates !== "function") {
+    return undefined;
+  }
+  try {
+    const certificates = getCACertificates("system");
+    return certificates.length > 0 ? certificates : undefined;
+  } catch {
+    return undefined;
+  }
+}
 
 export async function setupCa() {
   try {
+    const systemCertificates = systemCertificatesFromNode();
+    if (systemCertificates) {
+      globalAgent.options.ca = systemCertificates;
+      return;
+    }
+
