index 000000000..d68ca7e6b
--- /dev/null
+++ b/extensions/cli/src/ui/components/StreamingContent.tsx
@@ -0,0 +1,41 @@
+import { Box, Text } from "ink";
+import React from "react";
+
+import { useTerminalSize } from "../hooks/useTerminalSize.js";
+
+/**
+ * Fixed-height live preview for streamed assistant text.
+ *
+ * Ink redraws the dynamic area on every state update. If the preview grows
+ * line by line, each newline changes the layout and can make the terminal
+ * scroll or flicker (especially on Windows). Keeping a constant number of
+ * rows and showing only the tail makes every update a same-size repaint.
+ */
+export function StreamingContent(props: { content: string }) {
+  const { columns, rows } = useTerminalSize();
+  const maxLines = Math.max(3, Math.min(8, Math.floor(rows / 4)));
+  const maxChars = Math.max(1000, columns * maxLines * 4);
+  const content = props.content.replace(/\r\n/g, "\n");
+  const clipped = content.length > maxChars;
+  const tail = clipped ? content.slice(-maxChars) : content;
+  const lines = tail.split("\n").slice(-maxLines);
+
+  if (lines.length === 0) {
+    lines.push("");
+  }
+
+  return (
+    <Box
+      flexDirection="column"
+      height={maxLines}
+      flexShrink={0}
+      overflow="hidden"
+    >
+      {lines.map((line, index) => (
+        <Text key={index} wrap="truncate-end">
+          {index === 0 ? `${clipped ? "… " : "● "}${line}` : line || " "}
+        </Text>
+      ))}
+    </Box>
+  );
+}
diff --git a/extensions/cli/src/ui/hooks/useChat.stream.helpers.ts b/extensions/cli/src/ui/hooks/useChat.stream.helpers.ts
index 1f2937777..31ccc7362 100644
--- a/extensions/cli/src/ui/hooks/useChat.stream.helpers.ts
+++ b/extensions/cli/src/ui/hooks/useChat.stream.helpers.ts
@@ -32,24 +32,55 @@ export function createStreamCallbacks(
 
   // Live streaming: deltas are buffered and flushed at most every
   // STREAMING_FLUSH_INTERVAL_MS so the Ink UI re-renders a handful of times
-  // per second instead of on every token.
-  const STREAMING_FLUSH_INTERVAL_MS = 200;
+  // per second instead of on every token. The trailing timer guarantees the
+  // last tokens are shown even when the provider pauses after a delta.
+  const STREAMING_FLUSH_INTERVAL_MS = 150;
   let streamingBuffer = "";
   let lastStreamingFlush = 0;
+  let flushTimer: ReturnType<typeof setTimeout> | null = null;
+
+  const clearFlushTimer = () => {
+    if (!flushTimer) return;
+    clearTimeout(flushTimer);
+    flushTimer = null;
+  };
+
+  const flushStreaming = () => {
+    clearFlushTimer();
+    if (!setStreamingContent) return;
+    lastStreamingFlush = Date.now();
+    setStreamingContent(streamingBuffer);
+  };
+
+  const scheduleFlush = () => {
+    if (!setStreamingContent || flushTimer) return;
+    const delay = Math.max(
+      0,
+      STREAMING_FLUSH_INTERVAL_MS - (Date.now() - lastStreamingFlush),
+    );
+    flushTimer = setTimeout(() => {
+      flushTimer = null;
+      if (streamingBuffer) {
+        flushStreaming();
+      }
+    }, delay);
+  };
 
   return {
     onContent: (delta: string) => {
       if (!setStreamingContent) return;
       streamingBuffer += delta;
       if (Date.now() - lastStreamingFlush >= STREAMING_FLUSH_INTERVAL_MS) {
-        lastStreamingFlush = Date.now();
-        setStreamingContent(streamingBuffer);
+        flushStreaming();
+      } else {
+        scheduleFlush();
       }
     },
 
     onStreamReset: () => {
       // A mid-stream retry discarded the partial content of the failed
       // attempt: clear the streaming display before the new attempt.
+      clearFlushTimer();
       streamingBuffer = "";
       setStreamingContent?.("");
     },
@@ -57,6 +88,8 @@ export function createStreamCallbacks(
     onContentComplete: async (content: string) => {
       // The final assistant message lands in the chat history: the live
       // streaming display is no longer needed.
+      clearFlushTimer();
+      streamingBuffer = "";
       setStreamingContent?.(null);
       // Do not add assistant messages via service; handleToolCalls is the single writer
       // For environments where the service isn't ready (unit tests), update local state only
